/* Bottom face (z=-5) */
#200=ORIENTED_EDGE('',*,*,#34,.T.);
#201=ORIENTED_EDGE('',*,*,#39,.T.);
#202=ORIENTED_EDGE('',*,*,#44,.T.);
#203=ORIENTED_EDGE('',*,*,#49,.T.);
#204=EDGE_LOOP('',(#200,#201,#202,#203));
#205=FACE_OUTER_BOUND('',#204,.T.);
#206=ADVANCED_FACE('',(#205),#102,.F.);

/* Top face (z=5) */
#210=ORIENTED_EDGE('',*,*,#54,.T.);
