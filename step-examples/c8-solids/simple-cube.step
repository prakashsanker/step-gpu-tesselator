/* Edge lines - 12 edges of the cube */
/* Bottom face edges */
#30=CARTESIAN_POINT('',(-5.,-5.,-5.));
#31=DIRECTION('',(1.,0.,0.));
#32=VECTOR('',#31,10.);
#33=LINE('',#30,#32);
#34=EDGE_CURVE('',#11,#12,#33,.T.);

#35=CARTESIAN_POINT('',(5.,-5.,-5.));
#36=DIRECTION('',(0.,1.,0.));
#37=VECTOR('',#36,10.);
#38=LINE('',#35,#37);
