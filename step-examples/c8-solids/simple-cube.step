#67=VECTOR('',#66,10.);
#68=LINE('',#65,#67);
#69=EDGE_CURVE('',#18,#15,#68,.T.);

/* Vertical edges */
#70=CARTESIAN_POINT('',(-5.,-5.,-5.));
