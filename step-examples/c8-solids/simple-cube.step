#87=VECTOR('',#86,10.);
#88=LINE('',#85,#87);
#89=EDGE_CURVE('',#14,#18,#88,.T.);

/* Planes for the 6 faces */
#100=CARTESIAN_POINT('',(0.,0.,-5.));
