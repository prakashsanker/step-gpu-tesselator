#6=CARTESIAN_POINT('v5',(5.,-5.,5.));
#7=CARTESIAN_POINT('v6',(5.,5.,5.));
#8=CARTESIAN_POINT('v7',(-5.,5.,5.));

#11=VERTEX_POINT('',#1);
#12=VERTEX_POINT('',#2);
#13=VERTEX_POINT('',#3);
#14=VERTEX_POINT('',#4);
#15=VERTEX_POINT('',#5);
#16=VERTEX_POINT('',#6);
#17=VERTEX_POINT('',#7);
#18=VERTEX_POINT('',#8);

/* Directions for planes */
#20=DIRECTION('',(-1.,0.,0.));
