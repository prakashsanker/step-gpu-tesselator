/* C8: Closed shell containing all 6 faces */
#300=CLOSED_SHELL('cube_shell',(#206,#216,#226,#236,#246,#256));

/* C8: Manifold solid brep */
#301=MANIFOLD_SOLID_BREP('SimpleCube',#300);

/* Representation context */
#400=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#401,#402)) REPRESENTATION_CONTEXT('','3D'));
#401=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#402=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));

/* Shape representation */
#410=CARTESIAN_POINT('',(0.,0.,0.));
#411=DIRECTION('',(0.,0.,1.));
#412=DIRECTION('',(1.,0.,0.));
#413=AXIS2_PLACEMENT_3D('',#410,#411,#412);
#414=ADVANCED_BREP_SHAPE_REPRESENTATION('SimpleCube',(#301,#413),#400);

ENDSEC;
END-ISO-10303-21;
