/* Front face (y=-5) */
#240=ORIENTED_EDGE('',*,*,#34,.F.);
#241=ORIENTED_EDGE('',*,*,#74,.T.);
#242=ORIENTED_EDGE('',*,*,#54,.F.);
#243=ORIENTED_EDGE('',*,*,#79,.F.);
#244=EDGE_LOOP('',(#240,#241,#242,#243));
#245=FACE_OUTER_BOUND('',#244,.T.);
