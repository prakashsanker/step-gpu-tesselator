ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Simple cube for C8 testing - CLOSED_SHELL and MANIFOLD_SOLID_BREP'), '2;1');
FILE_NAME('simple-cube.step', '2024-01-04T00:00:00', (''), (''), '', '', '');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;

DATA;
/* Simple 10x10x10 cube centered at origin */

/* Vertices - 8 corners of the cube */
#1=CARTESIAN_POINT('v0',(-5.,-5.,-5.));
#2=CARTESIAN_POINT('v1',(5.,-5.,-5.));
#3=CARTESIAN_POINT('v2',(5.,5.,-5.));
