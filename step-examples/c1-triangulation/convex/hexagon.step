ISO-10303-21;
HEADER;
FILE_DESCRIPTION (( 'STEP AP214' ), '1' );
FILE_NAME ('hexagon.step', '2024-01-04T00:00:00', ( '' ), ( '' ), 'STEP Test', 'Test Generator', '' );
FILE_SCHEMA (( 'AUTOMOTIVE_DESIGN' ));
ENDSEC;

DATA;
/* ============================================ */
/* AP214 Required Product Structure             */
/* ============================================ */
#1 = APPLICATION_CONTEXT ( 'automotive_design' );
#2 = APPLICATION_PROTOCOL_DEFINITION ( 'draft international standard', 'automotive_design', 1998, #1 );
#3 = PRODUCT_CONTEXT ( 'NONE', #1, 'mechanical' );
#4 = PRODUCT ( 'hexagon', 'hexagon', '', ( #3 ) );
#5 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE ( 'ANY', '', #4, .NOT_KNOWN. );
#6 = PRODUCT_DEFINITION_CONTEXT ( 'detailed design', #1, 'design' );
#7 = PRODUCT_DEFINITION ( 'UNKNOWN', '', #5, #6 );
#8 = PRODUCT_DEFINITION_SHAPE ( 'NONE', 'NONE', #7 );
#9 = PRODUCT_RELATED_PRODUCT_CATEGORY ( 'part', '', ( #4 ) );

/* Units and context */
#10 = ( GEOMETRIC_REPRESENTATION_CONTEXT ( 3 ) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT ( ( #13 ) ) GLOBAL_UNIT_ASSIGNED_CONTEXT ( ( #14, #15, #16 ) ) REPRESENTATION_CONTEXT ( 'NONE', 'WORKASPACE' ) );
#13 = UNCERTAINTY_MEASURE_WITH_UNIT ( LENGTH_MEASURE( 1.0E-05 ), #14, 'distance_accuracy_value', 'NONE' );
#14 = ( LENGTH_UNIT ( ) NAMED_UNIT ( * ) SI_UNIT ( .MILLI., .METRE. ) );
#15 = ( NAMED_UNIT ( * ) PLANE_ANGLE_UNIT ( ) SI_UNIT ( $, .RADIAN. ) );
#16 = ( NAMED_UNIT ( * ) SOLID_ANGLE_UNIT ( ) SI_UNIT ( $, .STERADIAN. ) );

/* Origin placement */
#20 = CARTESIAN_POINT ( 'NONE', ( 0.0, 0.0, 0.0 ) );
#21 = DIRECTION ( 'NONE', ( 0.0, 0.0, 1.0 ) );
#22 = DIRECTION ( 'NONE', ( 1.0, 0.0, 0.0 ) );
#23 = AXIS2_PLACEMENT_3D ( 'NONE', #20, #21, #22 );

/* ============================================ */
/* Geometry                                     */
/* ============================================ */
#25 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
#26 = DIRECTION('', (0.0, 0.0, 1.0));
#27 = DIRECTION('', (1.0, 0.0, 0.0));
#28 = AXIS2_PLACEMENT_3D('', #25, #26, #27);
#29 = PLANE('', #28);

/* Hexagon vertices (unit hexagon centered at origin) */
#34 = CARTESIAN_POINT('', ( 1.0, 0.0, 0.0));                /* P0 */
#35 = CARTESIAN_POINT('', ( 0.5, 0.866025403784, 0.0));     /* P1 */
#36 = CARTESIAN_POINT('', (-0.5, 0.866025403784, 0.0));     /* P2 */
#37 = CARTESIAN_POINT('', (-1.0, 0.0, 0.0));                /* P3 */
#38 = CARTESIAN_POINT('', (-0.5, -0.866025403784, 0.0));    /* P4 */
#39 = CARTESIAN_POINT('', ( 0.5, -0.866025403784, 0.0));    /* P5 */

#44 = VERTEX_POINT('', #34);
#45 = VERTEX_POINT('', #35);
#46 = VERTEX_POINT('', #36);
#47 = VERTEX_POINT('', #37);
#48 = VERTEX_POINT('', #38);
#49 = VERTEX_POINT('', #39);

/* Directions for each edge (normalized) */
#54 = DIRECTION('', (-0.5, 0.866025403784, 0.0));           /* P0->P1 */
#55 = DIRECTION('', (-1.0, 0.0, 0.0));                      /* P1->P2 */
#56 = DIRECTION('', (-0.5, -0.866025403784, 0.0));          /* P2->P3 */
#57 = DIRECTION('', ( 0.5, -0.866025403784, 0.0));          /* P3->P4 */
#58 = DIRECTION('', ( 1.0, 0.0, 0.0));                      /* P4->P5 */
#59 = DIRECTION('', ( 0.5, 0.866025403784, 0.0));           /* P5->P0 */

/* Vectors (LINE requires VECTOR, not DIRECTION directly) */
#150 = VECTOR('', #54, 1.0);
#151 = VECTOR('', #55, 1.0);
#152 = VECTOR('', #56, 1.0);
#153 = VECTOR('', #57, 1.0);
#154 = VECTOR('', #58, 1.0);
#155 = VECTOR('', #59, 1.0);

/* Lines through each vertex with correct direction */
#64 = LINE('', #34, #150);
#65 = LINE('', #35, #151);
#66 = LINE('', #36, #152);
#67 = LINE('', #37, #153);
#68 = LINE('', #38, #154);
#69 = LINE('', #39, #155);

/* Edge curves */
#74 = EDGE_CURVE('', #44, #45, #64, .T.);
#75 = EDGE_CURVE('', #45, #46, #65, .T.);
#76 = EDGE_CURVE('', #46, #47, #66, .T.);
#77 = EDGE_CURVE('', #47, #48, #67, .T.);
#78 = EDGE_CURVE('', #48, #49, #68, .T.);
#79 = EDGE_CURVE('', #49, #44, #69, .T.);

/* Oriented edges */
#84 = ORIENTED_EDGE('', *, *, #74, .T.);
#85 = ORIENTED_EDGE('', *, *, #75, .T.);
#86 = ORIENTED_EDGE('', *, *, #76, .T.);
#87 = ORIENTED_EDGE('', *, *, #77, .T.);
#88 = ORIENTED_EDGE('', *, *, #78, .T.);
#89 = ORIENTED_EDGE('', *, *, #79, .T.);

#94 = EDGE_LOOP('', (#84, #85, #86, #87, #88, #89));
#104 = FACE_OUTER_BOUND('', #94, .T.);
#114 = ADVANCED_FACE('', (#104), #29, .T.);

/* ============================================ */
/* Shape Representation                         */
/* ============================================ */
#115 = ADVANCED_BREP_SHAPE_REPRESENTATION ( 'hexagon', ( #114, #23 ), #10 );
#116 = SHAPE_DEFINITION_REPRESENTATION ( #8, #115 );

ENDSEC;
END-ISO-10303-21;
