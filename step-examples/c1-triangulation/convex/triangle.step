ISO-10303-21;
HEADER;
FILE_DESCRIPTION (( 'STEP AP214' ), '1' );
FILE_NAME ('triangle.step', '2024-01-04T00:00:00', ( '' ), ( '' ), 'STEP Test', 'Test Generator', '' );
FILE_SCHEMA (( 'AUTOMOTIVE_DESIGN' ));
ENDSEC;

DATA;
/* ============================================ */
/* AP214 Required Product Structure             */
/* ============================================ */
#1 = APPLICATION_CONTEXT ( 'automotive_design' );
#2 = APPLICATION_PROTOCOL_DEFINITION ( 'draft international standard', 'automotive_design', 1998, #1 );
#3 = PRODUCT_CONTEXT ( 'NONE', #1, 'mechanical' );
#4 = PRODUCT ( 'triangle', 'triangle', '', ( #3 ) );
#5 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE ( 'ANY', '', #4, .NOT_KNOWN. );
#6 = PRODUCT_DEFINITION_CONTEXT ( 'detailed design', #1, 'design' );
#7 = PRODUCT_DEFINITION ( 'UNKNOWN', '', #5, #6 );
#8 = PRODUCT_DEFINITION_SHAPE ( 'NONE', 'NONE', #7 );
#9 = PRODUCT_RELATED_PRODUCT_CATEGORY ( 'part', '', ( #4 ) );

/* Units and context */
#10 = ( GEOMETRIC_REPRESENTATION_CONTEXT ( 3 ) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT ( ( #13 ) ) GLOBAL_UNIT_ASSIGNED_CONTEXT ( ( #14, #15, #16 ) ) REPRESENTATION_CONTEXT ( 'NONE', 'WORKASPACE' ) );
#13 = UNCERTAINTY_MEASURE_WITH_UNIT ( LENGTH_MEASURE( 1.0E-05 ), #14, 'distance_accuracy_value', 'NONE' );
#14 = ( LENGTH_UNIT ( ) NAMED_UNIT ( * ) SI_UNIT ( .MILLI., .METRE. ) );
#15 = ( NAMED_UNIT ( * ) PLANE_ANGLE_UNIT ( ) SI_UNIT ( $, .RADIAN. ) );
#16 = ( NAMED_UNIT ( * ) SOLID_ANGLE_UNIT ( ) SI_UNIT ( $, .STERADIAN. ) );

/* Origin placement */
#20 = CARTESIAN_POINT ( 'NONE', ( 0.0, 0.0, 0.0 ) );
#21 = DIRECTION ( 'NONE', ( 0.0, 0.0, 1.0 ) );
#22 = DIRECTION ( 'NONE', ( 1.0, 0.0, 0.0 ) );
#23 = AXIS2_PLACEMENT_3D ( 'NONE', #20, #21, #22 );

/* ============================================ */
/* Geometry                                     */
/* ============================================ */
#25 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
#26 = DIRECTION('', (0.0, 0.0, 1.0));
#27 = DIRECTION('', (1.0, 0.0, 0.0));
#28 = AXIS2_PLACEMENT_3D('', #25, #26, #27);
#29 = PLANE('', #28);

/* Triangle vertices: P0=(0,0,0), P1=(2,0,0), P2=(1,1.732,0) */
#34 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));                 /* P0 */
#35 = CARTESIAN_POINT('', (2.0, 0.0, 0.0));                 /* P1 */
#36 = CARTESIAN_POINT('', (1.0, 1.7320508075688772, 0.0));  /* P2 */

#44 = VERTEX_POINT('', #34);
#45 = VERTEX_POINT('', #35);
#46 = VERTEX_POINT('', #36);

/* Edge curves: each LINE must pass through BOTH vertices of its edge */
#54 = EDGE_CURVE('', #44, #45, #64, .T.);  /* P0 -> P1 */
#55 = EDGE_CURVE('', #45, #46, #65, .T.);  /* P1 -> P2 */
#56 = EDGE_CURVE('', #46, #44, #66, .T.);  /* P2 -> P0 */

/* Line definitions - direction must be along the edge */
/* Edge P0->P1: direction is (1, 0, 0) */
#64 = LINE('', #34, #124);
/* Edge P1->P2: direction is (-1, 1.732, 0) normalized = (-0.5, 0.866, 0) */
#65 = LINE('', #35, #125);
/* Edge P2->P0: direction is (-1, -1.732, 0) normalized = (-0.5, -0.866, 0) */
#66 = LINE('', #36, #126);

/* Directions for each edge */
#127 = DIRECTION('', (1.0, 0.0, 0.0));                      /* P0->P1 direction */
#128 = DIRECTION('', (-0.5, 0.8660254037844386, 0.0));      /* P1->P2 direction */
#129 = DIRECTION('', (-0.5, -0.8660254037844386, 0.0));     /* P2->P0 direction */

/* Vectors with magnitude 1.0 */
#124 = VECTOR('', #127, 1.0);
#125 = VECTOR('', #128, 1.0);
#126 = VECTOR('', #129, 1.0);

/* Oriented edges (all forward) */
#74 = ORIENTED_EDGE('', *, *, #54, .T.);
#75 = ORIENTED_EDGE('', *, *, #55, .T.);
#76 = ORIENTED_EDGE('', *, *, #56, .T.);

#84 = EDGE_LOOP('', (#74, #75, #76));
#94 = FACE_OUTER_BOUND('', #84, .T.);
#104 = ADVANCED_FACE('', (#94), #29, .T.);

/* ============================================ */
/* Shape Representation                         */
/* ============================================ */
#130 = ADVANCED_BREP_SHAPE_REPRESENTATION ( 'triangle', ( #104, #23 ), #10 );
#131 = SHAPE_DEFINITION_REPRESENTATION ( #8, #130 );

ENDSEC;
END-ISO-10303-21;
