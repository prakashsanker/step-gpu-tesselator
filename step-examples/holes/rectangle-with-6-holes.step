ISO-10303-21;
HEADER;
  FILE_DESCRIPTION(('Rectangle with 6 triangular holes in 2x3 grid'),'2;1');
  FILE_NAME('rect_6_holes.stp','20250104',(''),(''),'','','');
  FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;

  /* ==== Geometric context ==== */
  #1 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #2 = DIRECTION('', (0.0, 0.0, 1.0));
  #3 = DIRECTION('', (1.0, 0.0, 0.0));
  #4 = AXIS2_PLACEMENT_3D('', #1, #2, #3);
  #5 = PLANE('', #4);

  /* ==== OUTER BOUNDARY: Rectangle 15x10 ==== */
  #10 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #11 = CARTESIAN_POINT('', (15.0, 0.0, 0.0));
  #12 = CARTESIAN_POINT('', (15.0, 10.0, 0.0));
  #13 = CARTESIAN_POINT('', (0.0, 10.0, 0.0));

  #20 = VERTEX_POINT('', #10);
  #21 = VERTEX_POINT('', #11);
  #22 = VERTEX_POINT('', #12);
  #23 = VERTEX_POINT('', #13);

  #100 = VECTOR('', #3, 1.0);

  #30 = EDGE_CURVE('', #20, #21, #40, .T.);
  #31 = EDGE_CURVE('', #21, #22, #41, .T.);
  #32 = EDGE_CURVE('', #22, #23, #42, .T.);
  #33 = EDGE_CURVE('', #23, #20, #43, .T.);

  #40 = LINE('', #10, #100);
  #41 = LINE('', #11, #100);
  #42 = LINE('', #12, #100);
  #43 = LINE('', #13, #100);

  #50 = ORIENTED_EDGE('', *, *, #30, .T.);
  #51 = ORIENTED_EDGE('', *, *, #31, .T.);
  #52 = ORIENTED_EDGE('', *, *, #32, .T.);
  #53 = ORIENTED_EDGE('', *, *, #33, .T.);

  #60 = EDGE_LOOP('', (#50, #51, #52, #53));
  #70 = FACE_OUTER_BOUND('', #60, .T.);

  /* ==== HOLE 1: Row 1, Col 1 (bottom-left) ==== */
  #110 = CARTESIAN_POINT('', (1.0, 1.5, 0.0));
  #111 = CARTESIAN_POINT('', (4.0, 1.5, 0.0));
  #112 = CARTESIAN_POINT('', (2.5, 4.0, 0.0));

  #120 = VERTEX_POINT('', #110);
  #121 = VERTEX_POINT('', #111);
  #122 = VERTEX_POINT('', #112);

  #130 = EDGE_CURVE('', #120, #121, #140, .T.);
  #131 = EDGE_CURVE('', #121, #122, #141, .T.);
  #132 = EDGE_CURVE('', #122, #120, #142, .T.);

  #140 = LINE('', #110, #100);
  #141 = LINE('', #111, #100);
  #142 = LINE('', #112, #100);

  #150 = ORIENTED_EDGE('', *, *, #130, .T.);
  #151 = ORIENTED_EDGE('', *, *, #131, .T.);
  #152 = ORIENTED_EDGE('', *, *, #132, .T.);

  #160 = EDGE_LOOP('', (#150, #151, #152));
  #170 = FACE_BOUND('', #160, .T.);

  /* ==== HOLE 2: Row 1, Col 2 (bottom-center) ==== */
  #210 = CARTESIAN_POINT('', (6.0, 1.5, 0.0));
  #211 = CARTESIAN_POINT('', (9.0, 1.5, 0.0));
  #212 = CARTESIAN_POINT('', (7.5, 4.0, 0.0));

  #220 = VERTEX_POINT('', #210);
  #221 = VERTEX_POINT('', #211);
  #222 = VERTEX_POINT('', #212);

  #230 = EDGE_CURVE('', #220, #221, #240, .T.);
  #231 = EDGE_CURVE('', #221, #222, #241, .T.);
  #232 = EDGE_CURVE('', #222, #220, #242, .T.);

  #240 = LINE('', #210, #100);
  #241 = LINE('', #211, #100);
  #242 = LINE('', #212, #100);

  #250 = ORIENTED_EDGE('', *, *, #230, .T.);
  #251 = ORIENTED_EDGE('', *, *, #231, .T.);
  #252 = ORIENTED_EDGE('', *, *, #232, .T.);

  #260 = EDGE_LOOP('', (#250, #251, #252));
  #270 = FACE_BOUND('', #260, .T.);

  /* ==== HOLE 3: Row 1, Col 3 (bottom-right) ==== */
  #310 = CARTESIAN_POINT('', (11.0, 1.5, 0.0));
  #311 = CARTESIAN_POINT('', (14.0, 1.5, 0.0));
  #312 = CARTESIAN_POINT('', (12.5, 4.0, 0.0));

  #320 = VERTEX_POINT('', #310);
  #321 = VERTEX_POINT('', #311);
  #322 = VERTEX_POINT('', #312);

  #330 = EDGE_CURVE('', #320, #321, #340, .T.);
  #331 = EDGE_CURVE('', #321, #322, #341, .T.);
  #332 = EDGE_CURVE('', #322, #320, #342, .T.);

  #340 = LINE('', #310, #100);
  #341 = LINE('', #311, #100);
  #342 = LINE('', #312, #100);

  #350 = ORIENTED_EDGE('', *, *, #330, .T.);
  #351 = ORIENTED_EDGE('', *, *, #331, .T.);
  #352 = ORIENTED_EDGE('', *, *, #332, .T.);

  #360 = EDGE_LOOP('', (#350, #351, #352));
  #370 = FACE_BOUND('', #360, .T.);

  /* ==== HOLE 4: Row 2, Col 1 (top-left) ==== */
  #410 = CARTESIAN_POINT('', (1.0, 6.0, 0.0));
  #411 = CARTESIAN_POINT('', (4.0, 6.0, 0.0));
  #412 = CARTESIAN_POINT('', (2.5, 8.5, 0.0));

  #420 = VERTEX_POINT('', #410);
  #421 = VERTEX_POINT('', #411);
  #422 = VERTEX_POINT('', #412);

  #430 = EDGE_CURVE('', #420, #421, #440, .T.);
  #431 = EDGE_CURVE('', #421, #422, #441, .T.);
  #432 = EDGE_CURVE('', #422, #420, #442, .T.);

  #440 = LINE('', #410, #100);
  #441 = LINE('', #411, #100);
  #442 = LINE('', #412, #100);

  #450 = ORIENTED_EDGE('', *, *, #430, .T.);
  #451 = ORIENTED_EDGE('', *, *, #431, .T.);
  #452 = ORIENTED_EDGE('', *, *, #432, .T.);

  #460 = EDGE_LOOP('', (#450, #451, #452));
  #470 = FACE_BOUND('', #460, .T.);

  /* ==== HOLE 5: Row 2, Col 2 (top-center) ==== */
  #510 = CARTESIAN_POINT('', (6.0, 6.0, 0.0));
  #511 = CARTESIAN_POINT('', (9.0, 6.0, 0.0));
  #512 = CARTESIAN_POINT('', (7.5, 8.5, 0.0));

  #520 = VERTEX_POINT('', #510);
  #521 = VERTEX_POINT('', #511);
  #522 = VERTEX_POINT('', #512);

  #530 = EDGE_CURVE('', #520, #521, #540, .T.);
  #531 = EDGE_CURVE('', #521, #522, #541, .T.);
  #532 = EDGE_CURVE('', #522, #520, #542, .T.);

  #540 = LINE('', #510, #100);
  #541 = LINE('', #511, #100);
  #542 = LINE('', #512, #100);

  #550 = ORIENTED_EDGE('', *, *, #530, .T.);
  #551 = ORIENTED_EDGE('', *, *, #531, .T.);
  #552 = ORIENTED_EDGE('', *, *, #532, .T.);

  #560 = EDGE_LOOP('', (#550, #551, #552));
  #570 = FACE_BOUND('', #560, .T.);

  /* ==== HOLE 6: Row 2, Col 3 (top-right) ==== */
  #610 = CARTESIAN_POINT('', (11.0, 6.0, 0.0));
  #611 = CARTESIAN_POINT('', (14.0, 6.0, 0.0));
  #612 = CARTESIAN_POINT('', (12.5, 8.5, 0.0));

  #620 = VERTEX_POINT('', #610);
  #621 = VERTEX_POINT('', #611);
  #622 = VERTEX_POINT('', #612);

  #630 = EDGE_CURVE('', #620, #621, #640, .T.);
  #631 = EDGE_CURVE('', #621, #622, #641, .T.);
  #632 = EDGE_CURVE('', #622, #620, #642, .T.);

  #640 = LINE('', #610, #100);
  #641 = LINE('', #611, #100);
  #642 = LINE('', #612, #100);

  #650 = ORIENTED_EDGE('', *, *, #630, .T.);
  #651 = ORIENTED_EDGE('', *, *, #631, .T.);
  #652 = ORIENTED_EDGE('', *, *, #632, .T.);

  #660 = EDGE_LOOP('', (#650, #651, #652));
  #670 = FACE_BOUND('', #660, .T.);

  /* ==== FACE with outer bound and 6 holes ==== */
  #80 = ADVANCED_FACE('', (#70, #170, #270, #370, #470, #570, #670), #5, .T.);

ENDSEC;
END-ISO-10303-21;
