ISO-10303-21;
HEADER;
  FILE_DESCRIPTION(('Regular octagon - 8 vertices'),'2;1');
  FILE_NAME('octagon.stp','20250101',(''),(''),'','Test','');
  FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;

  /* ==== Geometric context ==== */

  #1 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #2 = DIRECTION('', (0.0, 0.0, 1.0));
  #3 = DIRECTION('', (1.0, 0.0, 0.0));
  #4 = AXIS2_PLACEMENT_3D('', #1, #2, #3);
  #5 = PLANE('', #4);

  /* ==== Regular octagon points (CCW) ==== */
  /* Centered at origin, radius 1 */
  /* Angles: 0, 45, 90, 135, 180, 225, 270, 315 degrees */

  #10 = CARTESIAN_POINT('', (1.0, 0.0, 0.0));                         /* P0: 0 deg */
  #11 = CARTESIAN_POINT('', (0.7071067811865476, 0.7071067811865476, 0.0));  /* P1: 45 deg */
  #12 = CARTESIAN_POINT('', (0.0, 1.0, 0.0));                         /* P2: 90 deg */
  #13 = CARTESIAN_POINT('', (-0.7071067811865476, 0.7071067811865476, 0.0)); /* P3: 135 deg */
  #14 = CARTESIAN_POINT('', (-1.0, 0.0, 0.0));                        /* P4: 180 deg */
  #15 = CARTESIAN_POINT('', (-0.7071067811865476, -0.7071067811865476, 0.0)); /* P5: 225 deg */
  #16 = CARTESIAN_POINT('', (0.0, -1.0, 0.0));                        /* P6: 270 deg */
  #17 = CARTESIAN_POINT('', (0.7071067811865476, -0.7071067811865476, 0.0)); /* P7: 315 deg */

  #20 = VERTEX_POINT('', #10);
  #21 = VERTEX_POINT('', #11);
  #22 = VERTEX_POINT('', #12);
  #23 = VERTEX_POINT('', #13);
  #24 = VERTEX_POINT('', #14);
  #25 = VERTEX_POINT('', #15);
  #26 = VERTEX_POINT('', #16);
  #27 = VERTEX_POINT('', #17);

  #100 = VECTOR('', #3, 1.0);
  #101 = VECTOR('', #3, 1.0);
  #102 = VECTOR('', #3, 1.0);
  #103 = VECTOR('', #3, 1.0);
  #104 = VECTOR('', #3, 1.0);
  #105 = VECTOR('', #3, 1.0);
  #106 = VECTOR('', #3, 1.0);
  #107 = VECTOR('', #3, 1.0);

  #40 = LINE('', #10, #100);
  #41 = LINE('', #11, #101);
  #42 = LINE('', #12, #102);
  #43 = LINE('', #13, #103);
  #44 = LINE('', #14, #104);
  #45 = LINE('', #15, #105);
  #46 = LINE('', #16, #106);
  #47 = LINE('', #17, #107);

  /* Edges in CCW order */

  #30 = EDGE_CURVE('', #20, #21, #40, .T.);  /* P0 -> P1 */
  #31 = EDGE_CURVE('', #21, #22, #41, .T.);  /* P1 -> P2 */
  #32 = EDGE_CURVE('', #22, #23, #42, .T.);  /* P2 -> P3 */
  #33 = EDGE_CURVE('', #23, #24, #43, .T.);  /* P3 -> P4 */
  #34 = EDGE_CURVE('', #24, #25, #44, .T.);  /* P4 -> P5 */
  #35 = EDGE_CURVE('', #25, #26, #45, .T.);  /* P5 -> P6 */
  #36 = EDGE_CURVE('', #26, #27, #46, .T.);  /* P6 -> P7 */
  #37 = EDGE_CURVE('', #27, #20, #47, .T.);  /* P7 -> P0 */

  #50 = ORIENTED_EDGE('', *, *, #30, .T.);
  #51 = ORIENTED_EDGE('', *, *, #31, .T.);
  #52 = ORIENTED_EDGE('', *, *, #32, .T.);
  #53 = ORIENTED_EDGE('', *, *, #33, .T.);
  #54 = ORIENTED_EDGE('', *, *, #34, .T.);
  #55 = ORIENTED_EDGE('', *, *, #35, .T.);
  #56 = ORIENTED_EDGE('', *, *, #36, .T.);
  #57 = ORIENTED_EDGE('', *, *, #37, .T.);

  #60 = EDGE_LOOP('', (#50, #51, #52, #53, #54, #55, #56, #57));

  #70 = FACE_OUTER_BOUND('', #60, .T.);
  #80 = ADVANCED_FACE('', (#70), #5, .T.);

ENDSEC;
END-ISO-10303-21;
