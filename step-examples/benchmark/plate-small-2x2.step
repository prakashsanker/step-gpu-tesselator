ISO-10303-21;
HEADER;
  FILE_DESCRIPTION(('Benchmark plate with 4 triangular holes (2x2 grid)'),'2;1');
  FILE_NAME('benchmark_plate_2x2.stp','2026-01-04',(''),(''),'','','');
  FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;

#1 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
#2 = DIRECTION('', (0.0, 0.0, 1.0));
#3 = DIRECTION('', (1.0, 0.0, 0.0));
#4 = AXIS2_PLACEMENT_3D('', #1, #2, #3);
#5 = PLANE('', #4);

/* Direction vectors for edges */
#600 = DIRECTION('', (1.0, 0.0, 0.0));    /* +X direction */
#601 = DIRECTION('', (0.0, 1.0, 0.0));    /* +Y direction */
#602 = DIRECTION('', (-1.0, 0.0, 0.0));   /* -X direction */
#603 = DIRECTION('', (0.0, -1.0, 0.0));   /* -Y direction */
#604 = DIRECTION('', (0.8944271909999159, -0.4472135954999579, 0.0));   /* diagonal down-right */
#605 = DIRECTION('', (-0.8944271909999159, -0.4472135954999579, 0.0));  /* diagonal down-left */

#610 = VECTOR('', #600, 1.0);  /* +X */
#611 = VECTOR('', #601, 1.0);  /* +Y */
#612 = VECTOR('', #602, 1.0);  /* -X */
#613 = VECTOR('', #603, 1.0);  /* -Y */
#614 = VECTOR('', #604, 1.0);  /* diagonal down-right */
#615 = VECTOR('', #605, 1.0);  /* diagonal down-left */

/* ==== Outer rectangular boundary (CCW) ==== */
#7 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
#8 = CARTESIAN_POINT('', (100.0, 0.0, 0.0));
#9 = CARTESIAN_POINT('', (100.0, 100.0, 0.0));
#10 = CARTESIAN_POINT('', (0.0, 100.0, 0.0));
#11 = VERTEX_POINT('', #7);
#12 = VERTEX_POINT('', #8);
#13 = VERTEX_POINT('', #9);
#14 = VERTEX_POINT('', #10);
#15 = LINE('', #7, #610);   /* (0,0) -> (100,0): +X */
#16 = LINE('', #8, #611);   /* (100,0) -> (100,100): +Y */
#17 = LINE('', #9, #612);   /* (100,100) -> (0,100): -X */
#18 = LINE('', #10, #613);  /* (0,100) -> (0,0): -Y */
#19 = EDGE_CURVE('', #11, #12, #15, .T.);
#20 = EDGE_CURVE('', #12, #13, #16, .T.);
#21 = EDGE_CURVE('', #13, #14, #17, .T.);
#22 = EDGE_CURVE('', #14, #11, #18, .T.);
#23 = ORIENTED_EDGE('', *, *, #19, .T.);
#24 = ORIENTED_EDGE('', *, *, #20, .T.);
#25 = ORIENTED_EDGE('', *, *, #21, .T.);
#26 = ORIENTED_EDGE('', *, *, #22, .T.);
#27 = EDGE_LOOP('', (#23, #24, #25, #26));
#28 = FACE_OUTER_BOUND('', #27, .T.);

/* ==== Hole 1 (row 0, col 0) CW ==== */
/* Triangle: (26,26) -> (26,29) -> (29,27.5) */
#29 = CARTESIAN_POINT('', (26.000, 26.000, 0.0));
#30 = CARTESIAN_POINT('', (26.000, 29.000, 0.0));
#31 = CARTESIAN_POINT('', (29.000, 27.500, 0.0));
#32 = VERTEX_POINT('', #29);
#33 = VERTEX_POINT('', #30);
#34 = VERTEX_POINT('', #31);
#35 = LINE('', #29, #611);  /* (26,26) -> (26,29): +Y */
#36 = LINE('', #30, #614);  /* (26,29) -> (29,27.5): diagonal down-right */
#37 = LINE('', #31, #615);  /* (29,27.5) -> (26,26): diagonal down-left */
#38 = EDGE_CURVE('', #32, #33, #35, .T.);
#39 = EDGE_CURVE('', #33, #34, #36, .T.);
#40 = EDGE_CURVE('', #34, #32, #37, .T.);
#41 = ORIENTED_EDGE('', *, *, #38, .T.);
#42 = ORIENTED_EDGE('', *, *, #39, .T.);
#43 = ORIENTED_EDGE('', *, *, #40, .T.);
#44 = EDGE_LOOP('', (#41, #42, #43));
#45 = FACE_BOUND('', #44, .T.);

/* ==== Hole 2 (row 0, col 1) CW ==== */
/* Triangle: (71,26) -> (71,29) -> (74,27.5) */
#46 = CARTESIAN_POINT('', (71.000, 26.000, 0.0));
#47 = CARTESIAN_POINT('', (71.000, 29.000, 0.0));
#48 = CARTESIAN_POINT('', (74.000, 27.500, 0.0));
#49 = VERTEX_POINT('', #46);
#50 = VERTEX_POINT('', #47);
#51 = VERTEX_POINT('', #48);
#52 = LINE('', #46, #611);  /* (71,26) -> (71,29): +Y */
#53 = LINE('', #47, #614);  /* (71,29) -> (74,27.5): diagonal down-right */
#54 = LINE('', #48, #615);  /* (74,27.5) -> (71,26): diagonal down-left */
#55 = EDGE_CURVE('', #49, #50, #52, .T.);
#56 = EDGE_CURVE('', #50, #51, #53, .T.);
#57 = EDGE_CURVE('', #51, #49, #54, .T.);
#58 = ORIENTED_EDGE('', *, *, #55, .T.);
#59 = ORIENTED_EDGE('', *, *, #56, .T.);
#60 = ORIENTED_EDGE('', *, *, #57, .T.);
#61 = EDGE_LOOP('', (#58, #59, #60));
#62 = FACE_BOUND('', #61, .T.);

/* ==== Hole 3 (row 1, col 0) CW ==== */
/* Triangle: (26,71) -> (26,74) -> (29,72.5) */
#63 = CARTESIAN_POINT('', (26.000, 71.000, 0.0));
#64 = CARTESIAN_POINT('', (26.000, 74.000, 0.0));
#65 = CARTESIAN_POINT('', (29.000, 72.500, 0.0));
#66 = VERTEX_POINT('', #63);
#67 = VERTEX_POINT('', #64);
#68 = VERTEX_POINT('', #65);
#69 = LINE('', #63, #611);  /* (26,71) -> (26,74): +Y */
#70 = LINE('', #64, #614);  /* (26,74) -> (29,72.5): diagonal down-right */
#71 = LINE('', #65, #615);  /* (29,72.5) -> (26,71): diagonal down-left */
#72 = EDGE_CURVE('', #66, #67, #69, .T.);
#73 = EDGE_CURVE('', #67, #68, #70, .T.);
#74 = EDGE_CURVE('', #68, #66, #71, .T.);
#75 = ORIENTED_EDGE('', *, *, #72, .T.);
#76 = ORIENTED_EDGE('', *, *, #73, .T.);
#77 = ORIENTED_EDGE('', *, *, #74, .T.);
#78 = EDGE_LOOP('', (#75, #76, #77));
#79 = FACE_BOUND('', #78, .T.);

/* ==== Hole 4 (row 1, col 1) CW ==== */
/* Triangle: (71,71) -> (71,74) -> (74,72.5) */
#80 = CARTESIAN_POINT('', (71.000, 71.000, 0.0));
#81 = CARTESIAN_POINT('', (71.000, 74.000, 0.0));
#82 = CARTESIAN_POINT('', (74.000, 72.500, 0.0));
#83 = VERTEX_POINT('', #80);
#84 = VERTEX_POINT('', #81);
#85 = VERTEX_POINT('', #82);
#86 = LINE('', #80, #611);  /* (71,71) -> (71,74): +Y */
#87 = LINE('', #81, #614);  /* (71,74) -> (74,72.5): diagonal down-right */
#88 = LINE('', #82, #615);  /* (74,72.5) -> (71,71): diagonal down-left */
#89 = EDGE_CURVE('', #83, #84, #86, .T.);
#90 = EDGE_CURVE('', #84, #85, #87, .T.);
#91 = EDGE_CURVE('', #85, #83, #88, .T.);
#92 = ORIENTED_EDGE('', *, *, #89, .T.);
#93 = ORIENTED_EDGE('', *, *, #90, .T.);
#94 = ORIENTED_EDGE('', *, *, #91, .T.);
#95 = EDGE_LOOP('', (#92, #93, #94));
#96 = FACE_BOUND('', #95, .T.);

/* ==== Advanced face with outer and all holes ==== */
#97 = ADVANCED_FACE('', (#28, #45, #62, #79, #96), #5, .T.);

/* ==== Product structure for OCCT compatibility ==== */
#98 = CLOSED_SHELL('', (#97));
#99 = MANIFOLD_SOLID_BREP('', #98);
#100 = SHAPE_REPRESENTATION('', (#99), #901);

/* ==== Geometric context ==== */
#900 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#901 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#902)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#900,#903,#904)) REPRESENTATION_CONTEXT('Context','3D Context') );
#902 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#900,'');
#903 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#904 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );

/* ==== Product definition ==== */
#910 = PRODUCT('benchmark_plate','benchmark_plate','',(#911));
#911 = PRODUCT_CONTEXT('',#912,'mechanical');
#912 = APPLICATION_CONTEXT('automotive_design');
#913 = PRODUCT_DEFINITION_FORMATION('','',#910);
#914 = PRODUCT_DEFINITION('design','',#913,#915);
#915 = PRODUCT_DEFINITION_CONTEXT('part definition',#912,'design');
#916 = PRODUCT_DEFINITION_SHAPE('','',#914);
#917 = SHAPE_DEFINITION_REPRESENTATION(#916,#100);

ENDSEC;
END-ISO-10303-21;
