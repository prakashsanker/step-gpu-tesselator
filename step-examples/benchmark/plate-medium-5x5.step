#413 = EDGE_CURVE('', #407, #408, #410, .T.);
#414 = EDGE_CURVE('', #408, #406, #411, .T.);
#415 = ORIENTED_EDGE('', *, *, #412, .T.);
#416 = ORIENTED_EDGE('', *, *, #413, .T.);
#417 = ORIENTED_EDGE('', *, *, #414, .T.);
