ISO-10303-21;
HEADER;
  FILE_DESCRIPTION(('Regular hexagon tilted in 3D space'),'2;1');
  FILE_NAME('tilted_hexagon.stp','20250101',(''),(''),'','','');
  FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;

  /* ==== Geometric context ==== */
  /* Plane with normal n = (0, 0.707, 0.707) */
  /* u = (1, 0, 0) (ref direction) */
  /* v = cross(n, u) = (0, 0.707, -0.707) */

  #1 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #2 = DIRECTION('', (0.0, 0.707106781, 0.707106781));   /* normal */
  #3 = DIRECTION('', (1.0, 0.0, 0.0));                   /* ref direction (u) */
  #4 = AXIS2_PLACEMENT_3D('', #1, #2, #3);
  #5 = PLANE('', #4);

  /* ==== Hexagon vertices ==== */
  /* Regular hexagon with radius 2 in local u-v coordinates:
     (2, 0), (1, 1.732), (-1, 1.732), (-2, 0), (-1, -1.732), (1, -1.732)

     3D position = origin + local_x * u + local_y * v
                 = (local_x, 0.707*local_y, -0.707*local_y)
  */

  /* (2, 0) → (2, 0, 0) */
  #10 = CARTESIAN_POINT('', (2.0, 0.0, 0.0));

  /* (1, 1.732) → (1, 1.224, -1.224) */
  #11 = CARTESIAN_POINT('', (1.0, 1.224744871, -1.224744871));

  /* (-1, 1.732) → (-1, 1.224, -1.224) */
  #12 = CARTESIAN_POINT('', (-1.0, 1.224744871, -1.224744871));

  /* (-2, 0) → (-2, 0, 0) */
  #13 = CARTESIAN_POINT('', (-2.0, 0.0, 0.0));

  /* (-1, -1.732) → (-1, -1.224, 1.224) */
  #14 = CARTESIAN_POINT('', (-1.0, -1.224744871, 1.224744871));

  /* (1, -1.732) → (1, -1.224, 1.224) */
  #15 = CARTESIAN_POINT('', (1.0, -1.224744871, 1.224744871));

  #20 = VERTEX_POINT('', #10);
  #21 = VERTEX_POINT('', #11);
  #22 = VERTEX_POINT('', #12);
  #23 = VERTEX_POINT('', #13);
  #24 = VERTEX_POINT('', #14);
  #25 = VERTEX_POINT('', #15);

  #100 = VECTOR('', #3, 1.0);

  #40 = LINE('', #10, #100);
  #41 = LINE('', #11, #100);
  #42 = LINE('', #12, #100);
  #43 = LINE('', #13, #100);
  #44 = LINE('', #14, #100);
  #45 = LINE('', #15, #100);

  #30 = EDGE_CURVE('', #20, #21, #40, .T.);
  #31 = EDGE_CURVE('', #21, #22, #41, .T.);
  #32 = EDGE_CURVE('', #22, #23, #42, .T.);
  #33 = EDGE_CURVE('', #23, #24, #43, .T.);
  #34 = EDGE_CURVE('', #24, #25, #44, .T.);
  #35 = EDGE_CURVE('', #25, #20, #45, .T.);

  #50 = ORIENTED_EDGE('', *, *, #30, .T.);
  #51 = ORIENTED_EDGE('', *, *, #31, .T.);
  #52 = ORIENTED_EDGE('', *, *, #32, .T.);
  #53 = ORIENTED_EDGE('', *, *, #33, .T.);
  #54 = ORIENTED_EDGE('', *, *, #34, .T.);
  #55 = ORIENTED_EDGE('', *, *, #35, .T.);

  #60 = EDGE_LOOP('', (#50, #51, #52, #53, #54, #55));
  #70 = FACE_OUTER_BOUND('', #60, .T.);
  #80 = ADVANCED_FACE('', (#70), #5, .T.);

ENDSEC;
END-ISO-10303-21;
