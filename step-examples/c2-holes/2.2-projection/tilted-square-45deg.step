ISO-10303-21;
HEADER;
  FILE_DESCRIPTION(('Square tilted 45 degrees around Y axis'),'2;1');
  FILE_NAME('tilted_square_45.stp','20250101',(''),(''),'','','');
  FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;

  /* ==== Geometric context ==== */
  /* Plane tilted 45 degrees: normal is (0.707, 0, 0.707) */

  #1 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #2 = DIRECTION('', (0.707106781, 0.0, 0.707106781));   /* normal (tilted) */
  #3 = DIRECTION('', (0.707106781, 0.0, -0.707106781));  /* ref direction (u) */
  #4 = AXIS2_PLACEMENT_3D('', #1, #2, #3);
  #5 = PLANE('', #4);

  /* ==== Square vertices on tilted plane ==== */
  /* Square with side length 2, tilted 45 degrees around Y axis */
  /* Vertices: A(0,0,0), B(1.414,0,-1.414), C(1.414,2,-1.414), D(0,2,0) */

  #10 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #11 = CARTESIAN_POINT('', (1.414213562, 0.0, -1.414213562));
  #12 = CARTESIAN_POINT('', (1.414213562, 2.0, -1.414213562));
  #13 = CARTESIAN_POINT('', (0.0, 2.0, 0.0));

  #20 = VERTEX_POINT('', #10);
  #21 = VERTEX_POINT('', #11);
  #22 = VERTEX_POINT('', #12);
  #23 = VERTEX_POINT('', #13);

  #100 = VECTOR('', #3, 1.0);

  #40 = LINE('', #10, #100);
  #41 = LINE('', #11, #100);
  #42 = LINE('', #12, #100);
  #43 = LINE('', #13, #100);

  #30 = EDGE_CURVE('', #20, #21, #40, .T.);
  #31 = EDGE_CURVE('', #21, #22, #41, .T.);
  #32 = EDGE_CURVE('', #22, #23, #42, .T.);
  #33 = EDGE_CURVE('', #23, #20, #43, .T.);

  #50 = ORIENTED_EDGE('', *, *, #30, .T.);
  #51 = ORIENTED_EDGE('', *, *, #31, .T.);
  #52 = ORIENTED_EDGE('', *, *, #32, .T.);
  #53 = ORIENTED_EDGE('', *, *, #33, .T.);

  #60 = EDGE_LOOP('', (#50, #51, #52, #53));
  #70 = FACE_OUTER_BOUND('', #60, .T.);
  #80 = ADVANCED_FACE('', (#70), #5, .T.);

ENDSEC;
END-ISO-10303-21;
