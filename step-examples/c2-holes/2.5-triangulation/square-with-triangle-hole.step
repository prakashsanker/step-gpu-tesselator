#5 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE ( 'ANY', '', #4, .NOT_KNOWN. );
#6 = PRODUCT_DEFINITION_CONTEXT ( 'detailed design', #1, 'design' );
#7 = PRODUCT_DEFINITION ( 'UNKNOWN', '', #5, #6 );
#8 = PRODUCT_DEFINITION_SHAPE ( 'NONE', 'NONE', #7 );
#9 = PRODUCT_RELATED_PRODUCT_CATEGORY ( 'part', '', ( #4 ) );

/* Units and context */
#10 = ( GEOMETRIC_REPRESENTATION_CONTEXT ( 3 ) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT ( ( #13 ) ) GLOBAL_UNIT_ASSIGNED_CONTEXT ( ( #14, #15, #16 ) ) REPRESENTATION_CONTEXT ( 'NONE', 'WORKASPACE' ) );
#13 = UNCERTAINTY_MEASURE_WITH_UNIT ( LENGTH_MEASURE( 1.0E-05 ), #14, 'distance_accuracy_value', 'NONE' );
#14 = ( LENGTH_UNIT ( ) NAMED_UNIT ( * ) SI_UNIT ( .MILLI., .METRE. ) );
#15 = ( NAMED_UNIT ( * ) PLANE_ANGLE_UNIT ( ) SI_UNIT ( $, .RADIAN. ) );
#16 = ( NAMED_UNIT ( * ) SOLID_ANGLE_UNIT ( ) SI_UNIT ( $, .STERADIAN. ) );

/* Origin placement */
#20 = CARTESIAN_POINT ( 'NONE', ( 0.0, 0.0, 0.0 ) );
#21 = DIRECTION ( 'NONE', ( 0.0, 0.0, 1.0 ) );
#22 = DIRECTION ( 'NONE', ( 1.0, 0.0, 0.0 ) );
#23 = AXIS2_PLACEMENT_3D ( 'NONE', #20, #21, #22 );

/* ============================================ */
/* Geometry                                     */
/* ============================================ */
#25 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
#26 = DIRECTION('', (0.0, 0.0, 1.0));
#27 = DIRECTION('', (1.0, 0.0, 0.0));
#28 = AXIS2_PLACEMENT_3D('', #25, #26, #27);
#29 = PLANE('', #28);

/* Outer square vertices: (0,0), (4,0), (4,4), (0,4) */
#34 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
#35 = CARTESIAN_POINT('', (4.0, 0.0, 0.0));
#36 = CARTESIAN_POINT('', (4.0, 4.0, 0.0));
#37 = CARTESIAN_POINT('', (0.0, 4.0, 0.0));

#44 = VERTEX_POINT('', #34);
#45 = VERTEX_POINT('', #35);
#46 = VERTEX_POINT('', #36);
#47 = VERTEX_POINT('', #37);

/* Outer square edge curves */
#54 = EDGE_CURVE('', #44, #45, #64, .T.);  /* (0,0) -> (4,0) */
#55 = EDGE_CURVE('', #45, #46, #65, .T.);  /* (4,0) -> (4,4) */
#56 = EDGE_CURVE('', #46, #47, #66, .T.);  /* (4,4) -> (0,4) */
#57 = EDGE_CURVE('', #47, #44, #67, .T.);  /* (0,4) -> (0,0) */

/* Directions for outer square edges */
#200 = DIRECTION('', (1.0, 0.0, 0.0));    /* (0,0) -> (4,0) direction */
#201 = DIRECTION('', (0.0, 1.0, 0.0));    /* (4,0) -> (4,4) direction */
#202 = DIRECTION('', (-1.0, 0.0, 0.0));   /* (4,4) -> (0,4) direction */
#203 = DIRECTION('', (0.0, -1.0, 0.0));   /* (0,4) -> (0,0) direction */

/* Vectors for outer square edges */
#210 = VECTOR('', #200, 1.0);
#211 = VECTOR('', #201, 1.0);
#212 = VECTOR('', #202, 1.0);
#213 = VECTOR('', #203, 1.0);

/* Lines for outer square edges */
#64 = LINE('', #34, #210);
#65 = LINE('', #35, #211);
#66 = LINE('', #36, #212);
#67 = LINE('', #37, #213);

/* Outer square oriented edges */
#74 = ORIENTED_EDGE('', *, *, #54, .T.);
#75 = ORIENTED_EDGE('', *, *, #55, .T.);
#76 = ORIENTED_EDGE('', *, *, #56, .T.);
#77 = ORIENTED_EDGE('', *, *, #57, .T.);

#84 = EDGE_LOOP('', (#74, #75, #76, #77));
#94 = FACE_OUTER_BOUND('', #84, .T.);

/* Triangle hole vertices: (1,1), (3,1), (2,3) */
#134 = CARTESIAN_POINT('', (1.0, 1.0, 0.0));
#135 = CARTESIAN_POINT('', (3.0, 1.0, 0.0));
#136 = CARTESIAN_POINT('', (2.0, 3.0, 0.0));

#144 = VERTEX_POINT('', #134);
#145 = VERTEX_POINT('', #135);
#146 = VERTEX_POINT('', #136);

/* Triangle hole edge curves */
#154 = EDGE_CURVE('', #144, #145, #164, .T.);  /* (1,1) -> (3,1) */
#155 = EDGE_CURVE('', #145, #146, #165, .T.);  /* (3,1) -> (2,3) */
#156 = EDGE_CURVE('', #146, #144, #166, .T.);  /* (2,3) -> (1,1) */

/* Directions for triangle hole edges (normalized) */
#220 = DIRECTION('', (1.0, 0.0, 0.0));                        /* (1,1) -> (3,1) direction */
#221 = DIRECTION('', (-0.4472135954999579, 0.8944271909999159, 0.0));  /* (3,1) -> (2,3) direction: (-1,2,0)/sqrt(5) */
#222 = DIRECTION('', (-0.4472135954999579, -0.8944271909999159, 0.0)); /* (2,3) -> (1,1) direction: (-1,-2,0)/sqrt(5) */

/* Vectors for triangle hole edges */
#230 = VECTOR('', #220, 1.0);
#231 = VECTOR('', #221, 1.0);
#232 = VECTOR('', #222, 1.0);

/* Lines for triangle hole edges */
#164 = LINE('', #134, #230);
#165 = LINE('', #135, #231);
#166 = LINE('', #136, #232);

/* Triangle hole oriented edges */
#174 = ORIENTED_EDGE('', *, *, #154, .T.);
#175 = ORIENTED_EDGE('', *, *, #155, .T.);
#176 = ORIENTED_EDGE('', *, *, #156, .T.);

#184 = EDGE_LOOP('', (#174, #175, #176));
#194 = FACE_BOUND('', #184, .T.);

/* Face with outer bound and hole */
#104 = ADVANCED_FACE('', (#94, #194), #29, .T.);

/* ============================================ */
/* Shape Representation                         */
/* ============================================ */
#195 = ADVANCED_BREP_SHAPE_REPRESENTATION ( 'square_with_triangle_hole', ( #104, #23 ), #10 );
#196 = SHAPE_DEFINITION_REPRESENTATION ( #8, #195 );

