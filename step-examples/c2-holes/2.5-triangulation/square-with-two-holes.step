ISO-10303-21;
HEADER;
  FILE_DESCRIPTION(('Square face with two triangular holes'),'2;1');
  FILE_NAME('square_with_two_holes.stp','20250101',(''),(''),'','','');
  FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;

  /* ==== Geometric context ==== */

  #1 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #2 = DIRECTION('', (0.0, 0.0, 1.0));
  #3 = DIRECTION('', (1.0, 0.0, 0.0));
  #4 = AXIS2_PLACEMENT_3D('', #1, #2, #3);
  #5 = PLANE('', #4);

  /* ==== OUTER BOUNDARY: Square (0,0) -> (6,0) -> (6,4) -> (0,4) CCW ==== */

  #10 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #11 = CARTESIAN_POINT('', (6.0, 0.0, 0.0));
  #12 = CARTESIAN_POINT('', (6.0, 4.0, 0.0));
  #13 = CARTESIAN_POINT('', (0.0, 4.0, 0.0));

  #20 = VERTEX_POINT('', #10);
  #21 = VERTEX_POINT('', #11);
  #22 = VERTEX_POINT('', #12);
  #23 = VERTEX_POINT('', #13);

  #100 = VECTOR('', #3, 1.0);

  #40 = LINE('', #10, #100);
  #41 = LINE('', #11, #100);
  #42 = LINE('', #12, #100);
  #43 = LINE('', #13, #100);

  #30 = EDGE_CURVE('', #20, #21, #40, .T.);
  #31 = EDGE_CURVE('', #21, #22, #41, .T.);
  #32 = EDGE_CURVE('', #22, #23, #42, .T.);
  #33 = EDGE_CURVE('', #23, #20, #43, .T.);

  #50 = ORIENTED_EDGE('', *, *, #30, .T.);
  #51 = ORIENTED_EDGE('', *, *, #31, .T.);
  #52 = ORIENTED_EDGE('', *, *, #32, .T.);
  #53 = ORIENTED_EDGE('', *, *, #33, .T.);

  #60 = EDGE_LOOP('', (#50, #51, #52, #53));

  #70 = FACE_OUTER_BOUND('', #60, .T.);

  /* ==== HOLE 1: Triangle on left side (1,1) -> (2,1) -> (1.5,3) ==== */

  #110 = CARTESIAN_POINT('', (1.0, 1.0, 0.0));
  #111 = CARTESIAN_POINT('', (2.0, 1.0, 0.0));
  #112 = CARTESIAN_POINT('', (1.5, 3.0, 0.0));

  #120 = VERTEX_POINT('', #110);
  #121 = VERTEX_POINT('', #111);
  #122 = VERTEX_POINT('', #112);

  #140 = LINE('', #110, #100);
  #141 = LINE('', #111, #100);
  #142 = LINE('', #112, #100);

  #130 = EDGE_CURVE('', #120, #121, #140, .T.);
  #131 = EDGE_CURVE('', #121, #122, #141, .T.);
  #132 = EDGE_CURVE('', #122, #120, #142, .T.);

  #150 = ORIENTED_EDGE('', *, *, #130, .T.);
  #151 = ORIENTED_EDGE('', *, *, #131, .T.);
  #152 = ORIENTED_EDGE('', *, *, #132, .T.);

  #160 = EDGE_LOOP('', (#150, #151, #152));

  #170 = FACE_BOUND('', #160, .T.);

  /* ==== HOLE 2: Triangle on right side (4,1) -> (5,1) -> (4.5,3) ==== */

  #210 = CARTESIAN_POINT('', (4.0, 1.0, 0.0));
  #211 = CARTESIAN_POINT('', (5.0, 1.0, 0.0));
  #212 = CARTESIAN_POINT('', (4.5, 3.0, 0.0));

  #220 = VERTEX_POINT('', #210);
  #221 = VERTEX_POINT('', #211);
  #222 = VERTEX_POINT('', #212);

  #240 = LINE('', #210, #100);
  #241 = LINE('', #211, #100);
  #242 = LINE('', #212, #100);

  #230 = EDGE_CURVE('', #220, #221, #240, .T.);
  #231 = EDGE_CURVE('', #221, #222, #241, .T.);
  #232 = EDGE_CURVE('', #222, #220, #242, .T.);

  #250 = ORIENTED_EDGE('', *, *, #230, .T.);
  #251 = ORIENTED_EDGE('', *, *, #231, .T.);
  #252 = ORIENTED_EDGE('', *, *, #232, .T.);

  #260 = EDGE_LOOP('', (#250, #251, #252));

  #270 = FACE_BOUND('', #260, .T.);

  /* ==== FACE with outer bound and two holes ==== */

  #80 = ADVANCED_FACE('', (#70, #170, #270), #5, .T.);

ENDSEC;
END-ISO-10303-21;
