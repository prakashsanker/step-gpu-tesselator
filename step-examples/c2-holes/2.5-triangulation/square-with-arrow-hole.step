ISO-10303-21;
HEADER;
  FILE_DESCRIPTION(('Square with arrow-shaped (concave) hole'),'2;1');
  FILE_NAME('square_arrow_hole.stp','20250104',(''),(''),'','','');
  FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;

  /* ==== Geometric context ==== */
  #1 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #2 = DIRECTION('', (0.0, 0.0, 1.0));
  #3 = DIRECTION('', (1.0, 0.0, 0.0));
  #4 = AXIS2_PLACEMENT_3D('', #1, #2, #3);
  #5 = PLANE('', #4);

  /* ==== OUTER BOUNDARY: Square 10x10 ==== */
  #10 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #11 = CARTESIAN_POINT('', (10.0, 0.0, 0.0));
  #12 = CARTESIAN_POINT('', (10.0, 10.0, 0.0));
  #13 = CARTESIAN_POINT('', (0.0, 10.0, 0.0));

  #20 = VERTEX_POINT('', #10);
  #21 = VERTEX_POINT('', #11);
  #22 = VERTEX_POINT('', #12);
  #23 = VERTEX_POINT('', #13);

  #100 = VECTOR('', #3, 1.0);

  #30 = EDGE_CURVE('', #20, #21, #40, .T.);
  #31 = EDGE_CURVE('', #21, #22, #41, .T.);
  #32 = EDGE_CURVE('', #22, #23, #42, .T.);
  #33 = EDGE_CURVE('', #23, #20, #43, .T.);

  #40 = LINE('', #10, #100);
  #41 = LINE('', #11, #100);
  #42 = LINE('', #12, #100);
  #43 = LINE('', #13, #100);

  #50 = ORIENTED_EDGE('', *, *, #30, .T.);
  #51 = ORIENTED_EDGE('', *, *, #31, .T.);
  #52 = ORIENTED_EDGE('', *, *, #32, .T.);
  #53 = ORIENTED_EDGE('', *, *, #33, .T.);

  #60 = EDGE_LOOP('', (#50, #51, #52, #53));
  #70 = FACE_OUTER_BOUND('', #60, .T.);

  /* ==== HOLE: Arrow shape (concave, 7 vertices) pointing right ====

           (2,7)────────────────(7,7)
             |                    \
             |                     \
           (2,6)───(4,6)            (8,5) ← arrow tip
             |       |             /
             |       |            /
           (2,4)───(4,4)────────(7,3)
             |
           (2,3)
  */
  #110 = CARTESIAN_POINT('', (2.0, 3.0, 0.0));
  #111 = CARTESIAN_POINT('', (7.0, 3.0, 0.0));
  #112 = CARTESIAN_POINT('', (8.0, 5.0, 0.0));
  #113 = CARTESIAN_POINT('', (7.0, 7.0, 0.0));
  #114 = CARTESIAN_POINT('', (2.0, 7.0, 0.0));
  #115 = CARTESIAN_POINT('', (2.0, 6.0, 0.0));
  #116 = CARTESIAN_POINT('', (4.0, 6.0, 0.0));
  #117 = CARTESIAN_POINT('', (4.0, 4.0, 0.0));
  #118 = CARTESIAN_POINT('', (2.0, 4.0, 0.0));

  #120 = VERTEX_POINT('', #110);
  #121 = VERTEX_POINT('', #111);
  #122 = VERTEX_POINT('', #112);
  #123 = VERTEX_POINT('', #113);
  #124 = VERTEX_POINT('', #114);
  #125 = VERTEX_POINT('', #115);
  #126 = VERTEX_POINT('', #116);
  #127 = VERTEX_POINT('', #117);
  #128 = VERTEX_POINT('', #118);

  #130 = EDGE_CURVE('', #120, #121, #140, .T.);
  #131 = EDGE_CURVE('', #121, #122, #141, .T.);
  #132 = EDGE_CURVE('', #122, #123, #142, .T.);
  #133 = EDGE_CURVE('', #123, #124, #143, .T.);
  #134 = EDGE_CURVE('', #124, #125, #144, .T.);
  #135 = EDGE_CURVE('', #125, #126, #145, .T.);
  #136 = EDGE_CURVE('', #126, #127, #146, .T.);
  #137 = EDGE_CURVE('', #127, #128, #147, .T.);
  #138 = EDGE_CURVE('', #128, #120, #148, .T.);

  #140 = LINE('', #110, #100);
  #141 = LINE('', #111, #100);
  #142 = LINE('', #112, #100);
  #143 = LINE('', #113, #100);
  #144 = LINE('', #114, #100);
  #145 = LINE('', #115, #100);
  #146 = LINE('', #116, #100);
  #147 = LINE('', #117, #100);
  #148 = LINE('', #118, #100);

  #150 = ORIENTED_EDGE('', *, *, #130, .T.);
  #151 = ORIENTED_EDGE('', *, *, #131, .T.);
  #152 = ORIENTED_EDGE('', *, *, #132, .T.);
  #153 = ORIENTED_EDGE('', *, *, #133, .T.);
  #154 = ORIENTED_EDGE('', *, *, #134, .T.);
  #155 = ORIENTED_EDGE('', *, *, #135, .T.);
  #156 = ORIENTED_EDGE('', *, *, #136, .T.);
  #157 = ORIENTED_EDGE('', *, *, #137, .T.);
  #158 = ORIENTED_EDGE('', *, *, #138, .T.);

  #160 = EDGE_LOOP('', (#150, #151, #152, #153, #154, #155, #156, #157, #158));
  #170 = FACE_BOUND('', #160, .T.);

  /* ==== FACE with outer bound and arrow hole ==== */
  #80 = ADVANCED_FACE('', (#70, #170), #5, .T.);

ENDSEC;
END-ISO-10303-21;
