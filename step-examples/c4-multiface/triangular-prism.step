ISO-10303-21;
HEADER;
  FILE_DESCRIPTION(('Triangular prism - 5 faces (2 triangles + 3 quads)'),'2;1');
  FILE_NAME('triangular-prism.stp','2025-01-04',(''),(''),'','','');
  FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;

  /* ==== Vertices of triangular prism ====
     Front triangle (z=2):
       V1 = (0, 0, 2)
       V2 = (2, 0, 2)
       V3 = (1, 1.732, 2)
     Back triangle (z=0):
       V4 = (0, 0, 0)
       V5 = (2, 0, 0)
       V6 = (1, 1.732, 0)
  */

  #1 = CARTESIAN_POINT('V1', (0.0, 0.0, 2.0));
  #2 = CARTESIAN_POINT('V2', (2.0, 0.0, 2.0));
  #3 = CARTESIAN_POINT('V3', (1.0, 1.732, 2.0));
  #4 = CARTESIAN_POINT('V4', (0.0, 0.0, 0.0));
  #5 = CARTESIAN_POINT('V5', (2.0, 0.0, 0.0));
  #6 = CARTESIAN_POINT('V6', (1.0, 1.732, 0.0));

  #11 = VERTEX_POINT('', #1);
  #12 = VERTEX_POINT('', #2);
  #13 = VERTEX_POINT('', #3);
  #14 = VERTEX_POINT('', #4);
  #15 = VERTEX_POINT('', #5);
  #16 = VERTEX_POINT('', #6);

  /* ==== Lines for edges ==== */
  /* Front triangle */
  #20 = CARTESIAN_POINT('', (0.0, 0.0, 2.0));
  #21 = DIRECTION('', (1.0, 0.0, 0.0));
  #22 = VECTOR('', #21, 1.0);
  #23 = LINE('', #20, #22);

  #24 = CARTESIAN_POINT('', (2.0, 0.0, 2.0));
  #25 = DIRECTION('', (-0.5, 0.866, 0.0));
  #26 = VECTOR('', #25, 1.0);
  #27 = LINE('', #24, #26);

  #28 = CARTESIAN_POINT('', (1.0, 1.732, 2.0));
  #29 = DIRECTION('', (-0.5, -0.866, 0.0));
  #30 = VECTOR('', #29, 1.0);
  #31 = LINE('', #28, #30);

  /* Back triangle */
  #32 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #33 = DIRECTION('', (1.0, 0.0, 0.0));
  #34 = VECTOR('', #33, 1.0);
  #35 = LINE('', #32, #34);

  #36 = CARTESIAN_POINT('', (2.0, 0.0, 0.0));
  #37 = DIRECTION('', (-0.5, 0.866, 0.0));
  #38 = VECTOR('', #37, 1.0);
  #39 = LINE('', #36, #38);

  #40 = CARTESIAN_POINT('', (1.0, 1.732, 0.0));
  #41 = DIRECTION('', (-0.5, -0.866, 0.0));
  #42 = VECTOR('', #41, 1.0);
  #43 = LINE('', #40, #42);

  /* Connecting edges (front to back) */
  #44 = CARTESIAN_POINT('', (0.0, 0.0, 2.0));
  #45 = DIRECTION('', (0.0, 0.0, -1.0));
  #46 = VECTOR('', #45, 1.0);
  #47 = LINE('', #44, #46);

  #48 = CARTESIAN_POINT('', (2.0, 0.0, 2.0));
  #49 = DIRECTION('', (0.0, 0.0, -1.0));
  #50 = VECTOR('', #49, 1.0);
  #51 = LINE('', #48, #50);

  #52 = CARTESIAN_POINT('', (1.0, 1.732, 2.0));
  #53 = DIRECTION('', (0.0, 0.0, -1.0));
  #54 = VECTOR('', #53, 1.0);
  #55 = LINE('', #52, #54);

  /* ==== Edge curves ==== */
  /* Front triangle */
  #60 = EDGE_CURVE('', #11, #12, #23, .T.);
  #61 = EDGE_CURVE('', #12, #13, #27, .T.);
  #62 = EDGE_CURVE('', #13, #11, #31, .T.);

  /* Back triangle */
  #63 = EDGE_CURVE('', #14, #15, #35, .T.);
  #64 = EDGE_CURVE('', #15, #16, #39, .T.);
  #65 = EDGE_CURVE('', #16, #14, #43, .T.);

  /* Connecting edges */
  #66 = EDGE_CURVE('', #11, #14, #47, .T.);
  #67 = EDGE_CURVE('', #12, #15, #51, .T.);
  #68 = EDGE_CURVE('', #13, #16, #55, .T.);

  /* ==== FACE 1: Front triangle (z=2) ==== */
  #100 = CARTESIAN_POINT('', (0.0, 0.0, 2.0));
  #101 = DIRECTION('', (0.0, 0.0, 1.0));
  #102 = DIRECTION('', (1.0, 0.0, 0.0));
  #103 = AXIS2_PLACEMENT_3D('', #100, #101, #102);
  #104 = PLANE('', #103);

  #105 = ORIENTED_EDGE('', *, *, #60, .T.);
  #106 = ORIENTED_EDGE('', *, *, #61, .T.);
  #107 = ORIENTED_EDGE('', *, *, #62, .T.);
  #109 = EDGE_LOOP('', (#105, #106, #107));
  #110 = FACE_OUTER_BOUND('', #109, .T.);
  #111 = ADVANCED_FACE('Front', (#110), #104, .T.);

  /* ==== FACE 2: Back triangle (z=0) ==== */
  #120 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #121 = DIRECTION('', (0.0, 0.0, -1.0));
  #122 = DIRECTION('', (1.0, 0.0, 0.0));
  #123 = AXIS2_PLACEMENT_3D('', #120, #121, #122);
  #124 = PLANE('', #123);

  #125 = ORIENTED_EDGE('', *, *, #63, .F.);
  #126 = ORIENTED_EDGE('', *, *, #65, .F.);
  #127 = ORIENTED_EDGE('', *, *, #64, .F.);
  #129 = EDGE_LOOP('', (#125, #126, #127));
  #130 = FACE_OUTER_BOUND('', #129, .T.);
  #131 = ADVANCED_FACE('Back', (#130), #124, .T.);

  /* ==== FACE 3: Bottom (y=0) ==== */
  #140 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #141 = DIRECTION('', (0.0, -1.0, 0.0));
  #142 = DIRECTION('', (1.0, 0.0, 0.0));
  #143 = AXIS2_PLACEMENT_3D('', #140, #141, #142);
  #144 = PLANE('', #143);

  #145 = ORIENTED_EDGE('', *, *, #60, .F.);
  #146 = ORIENTED_EDGE('', *, *, #66, .T.);
  #147 = ORIENTED_EDGE('', *, *, #63, .T.);
  #148 = ORIENTED_EDGE('', *, *, #67, .F.);
  #149 = EDGE_LOOP('', (#145, #146, #147, #148));
  #150 = FACE_OUTER_BOUND('', #149, .T.);
  #151 = ADVANCED_FACE('Bottom', (#150), #144, .T.);

  /* ==== FACE 4: Right side ==== */
  #160 = CARTESIAN_POINT('', (2.0, 0.0, 0.0));
  #161 = DIRECTION('', (0.866, 0.5, 0.0));
  #162 = DIRECTION('', (0.0, 0.0, 1.0));
  #163 = AXIS2_PLACEMENT_3D('', #160, #161, #162);
  #164 = PLANE('', #163);

  #165 = ORIENTED_EDGE('', *, *, #61, .F.);
  #166 = ORIENTED_EDGE('', *, *, #67, .T.);
  #167 = ORIENTED_EDGE('', *, *, #64, .T.);
  #168 = ORIENTED_EDGE('', *, *, #68, .F.);
  #169 = EDGE_LOOP('', (#165, #166, #167, #168));
  #170 = FACE_OUTER_BOUND('', #169, .T.);
  #171 = ADVANCED_FACE('Right', (#170), #164, .T.);

  /* ==== FACE 5: Left side ==== */
  #180 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #181 = DIRECTION('', (-0.866, 0.5, 0.0));
  #182 = DIRECTION('', (0.0, 0.0, 1.0));
  #183 = AXIS2_PLACEMENT_3D('', #180, #181, #182);
  #184 = PLANE('', #183);

  #185 = ORIENTED_EDGE('', *, *, #62, .F.);
  #186 = ORIENTED_EDGE('', *, *, #68, .T.);
  #187 = ORIENTED_EDGE('', *, *, #65, .T.);
  #188 = ORIENTED_EDGE('', *, *, #66, .F.);
  #189 = EDGE_LOOP('', (#185, #186, #187, #188));
  #190 = FACE_OUTER_BOUND('', #189, .T.);
  #191 = ADVANCED_FACE('Left', (#190), #184, .T.);

ENDSEC;
END-ISO-10303-21;
