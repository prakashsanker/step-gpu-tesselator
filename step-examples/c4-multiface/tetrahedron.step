ISO-10303-21;
HEADER;
  FILE_DESCRIPTION(('Tetrahedron - 4 triangular faces'),'2;1');
  FILE_NAME('tetrahedron.stp','2025-01-04',(''),(''),'','','');
  FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;

  /* ==== Vertices of tetrahedron ====
     V1 = (0, 0, 0)        - base front left
     V2 = (2, 0, 0)        - base front right
     V3 = (1, 1.732, 0)    - base back center (equilateral triangle)
     V4 = (1, 0.577, 1.633) - apex
  */

  #1 = CARTESIAN_POINT('V1', (0.0, 0.0, 0.0));
  #2 = CARTESIAN_POINT('V2', (2.0, 0.0, 0.0));
  #3 = CARTESIAN_POINT('V3', (1.0, 1.732, 0.0));
  #4 = CARTESIAN_POINT('V4', (1.0, 0.577, 1.633));

  #11 = VERTEX_POINT('', #1);
  #12 = VERTEX_POINT('', #2);
  #13 = VERTEX_POINT('', #3);
  #14 = VERTEX_POINT('', #4);

  /* ==== Lines for edges ==== */
  /* Base triangle edges */
  #20 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #21 = DIRECTION('', (1.0, 0.0, 0.0));
  #22 = VECTOR('', #21, 1.0);
  #23 = LINE('', #20, #22);

  #24 = CARTESIAN_POINT('', (2.0, 0.0, 0.0));
  #25 = DIRECTION('', (-0.5, 0.866, 0.0));
  #26 = VECTOR('', #25, 1.0);
  #27 = LINE('', #24, #26);

  #28 = CARTESIAN_POINT('', (1.0, 1.732, 0.0));
  #29 = DIRECTION('', (-0.5, -0.866, 0.0));
  #30 = VECTOR('', #29, 1.0);
  #31 = LINE('', #28, #30);

  /* Edges to apex */
  #32 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #33 = DIRECTION('', (0.5, 0.289, 0.816));
  #34 = VECTOR('', #33, 1.0);
  #35 = LINE('', #32, #34);

  #36 = CARTESIAN_POINT('', (2.0, 0.0, 0.0));
  #37 = DIRECTION('', (-0.5, 0.289, 0.816));
  #38 = VECTOR('', #37, 1.0);
  #39 = LINE('', #36, #38);

  #40 = CARTESIAN_POINT('', (1.0, 1.732, 0.0));
  #41 = DIRECTION('', (0.0, -0.577, 0.816));
  #42 = VECTOR('', #41, 1.0);
  #43 = LINE('', #40, #42);

  /* ==== Edge curves ==== */
  /* Base edges */
  #50 = EDGE_CURVE('', #11, #12, #23, .T.);
  #51 = EDGE_CURVE('', #12, #13, #27, .T.);
  #52 = EDGE_CURVE('', #13, #11, #31, .T.);

  /* Edges to apex */
  #53 = EDGE_CURVE('', #11, #14, #35, .T.);
  #54 = EDGE_CURVE('', #12, #14, #39, .T.);
  #55 = EDGE_CURVE('', #13, #14, #43, .T.);

  /* ==== FACE 1: Base (z=0) ==== */
  #100 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #101 = DIRECTION('', (0.0, 0.0, -1.0));
  #102 = DIRECTION('', (1.0, 0.0, 0.0));
  #103 = AXIS2_PLACEMENT_3D('', #100, #101, #102);
  #104 = PLANE('', #103);

  #105 = ORIENTED_EDGE('', *, *, #50, .F.);
  #106 = ORIENTED_EDGE('', *, *, #52, .F.);
  #107 = ORIENTED_EDGE('', *, *, #51, .F.);
  #109 = EDGE_LOOP('', (#105, #106, #107));
  #110 = FACE_OUTER_BOUND('', #109, .T.);
  #111 = ADVANCED_FACE('Base', (#110), #104, .T.);

  /* ==== FACE 2: Front (V1-V2-V4) ==== */
  #120 = CARTESIAN_POINT('', (1.0, 0.0, 0.0));
  #121 = DIRECTION('', (0.0, -0.816, 0.577));
  #122 = DIRECTION('', (1.0, 0.0, 0.0));
  #123 = AXIS2_PLACEMENT_3D('', #120, #121, #122);
  #124 = PLANE('', #123);

  #125 = ORIENTED_EDGE('', *, *, #50, .T.);
  #126 = ORIENTED_EDGE('', *, *, #54, .T.);
  #127 = ORIENTED_EDGE('', *, *, #53, .F.);
  #129 = EDGE_LOOP('', (#125, #126, #127));
  #130 = FACE_OUTER_BOUND('', #129, .T.);
  #131 = ADVANCED_FACE('Front', (#130), #124, .T.);

  /* ==== FACE 3: Right (V2-V3-V4) ==== */
  #140 = CARTESIAN_POINT('', (1.5, 0.866, 0.0));
  #141 = DIRECTION('', (0.816, 0.471, 0.333));
  #142 = DIRECTION('', (-0.5, 0.866, 0.0));
  #143 = AXIS2_PLACEMENT_3D('', #140, #141, #142);
  #144 = PLANE('', #143);

  #145 = ORIENTED_EDGE('', *, *, #51, .T.);
  #146 = ORIENTED_EDGE('', *, *, #55, .T.);
  #147 = ORIENTED_EDGE('', *, *, #54, .F.);
  #149 = EDGE_LOOP('', (#145, #146, #147));
  #150 = FACE_OUTER_BOUND('', #149, .T.);
  #151 = ADVANCED_FACE('Right', (#150), #144, .T.);

  /* ==== FACE 4: Left (V3-V1-V4) ==== */
  #160 = CARTESIAN_POINT('', (0.5, 0.866, 0.0));
  #161 = DIRECTION('', (-0.816, 0.471, 0.333));
  #162 = DIRECTION('', (-0.5, -0.866, 0.0));
  #163 = AXIS2_PLACEMENT_3D('', #160, #161, #162);
  #164 = PLANE('', #163);

  #165 = ORIENTED_EDGE('', *, *, #52, .T.);
  #166 = ORIENTED_EDGE('', *, *, #53, .T.);
  #167 = ORIENTED_EDGE('', *, *, #55, .F.);
  #169 = EDGE_LOOP('', (#165, #166, #167));
  #170 = FACE_OUTER_BOUND('', #169, .T.);
  #171 = ADVANCED_FACE('Left', (#170), #164, .T.);

ENDSEC;
END-ISO-10303-21;
