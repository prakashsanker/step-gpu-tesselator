ISO-10303-21;
HEADER;
  FILE_DESCRIPTION(('Valid: square with centered triangular hole'),'2;1');
  FILE_NAME('valid_square_with_hole.stp','20250102',(''),(''),'','','');
  FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;

  /* ==== Geometric context ==== */
  #1 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #2 = DIRECTION('', (0.0, 0.0, 1.0));
  #3 = DIRECTION('', (1.0, 0.0, 0.0));
  #4 = AXIS2_PLACEMENT_3D('', #1, #2, #3);
  #5 = PLANE('', #4);

  /* ==== Outer square (0,0) to (4,4) CCW ==== */
  #10 = CARTESIAN_POINT('', (0.0, 0.0, 0.0));
  #11 = CARTESIAN_POINT('', (4.0, 0.0, 0.0));
  #12 = CARTESIAN_POINT('', (4.0, 4.0, 0.0));
  #13 = CARTESIAN_POINT('', (0.0, 4.0, 0.0));

  #20 = VERTEX_POINT('', #10);
  #21 = VERTEX_POINT('', #11);
  #22 = VERTEX_POINT('', #12);
  #23 = VERTEX_POINT('', #13);

  #100 = VECTOR('', #3, 1.0);

  #40 = LINE('', #10, #100);
  #41 = LINE('', #11, #100);
  #42 = LINE('', #12, #100);
  #43 = LINE('', #13, #100);

  #30 = EDGE_CURVE('', #20, #21, #40, .T.);
  #31 = EDGE_CURVE('', #21, #22, #41, .T.);
  #32 = EDGE_CURVE('', #22, #23, #42, .T.);
  #33 = EDGE_CURVE('', #23, #20, #43, .T.);

  #50 = ORIENTED_EDGE('', *, *, #30, .T.);
  #51 = ORIENTED_EDGE('', *, *, #31, .T.);
  #52 = ORIENTED_EDGE('', *, *, #32, .T.);
  #53 = ORIENTED_EDGE('', *, *, #33, .T.);

  #60 = EDGE_LOOP('', (#50, #51, #52, #53));
  #70 = FACE_OUTER_BOUND('', #60, .T.);

  /* ==== Inner triangle centered at (2,2) ==== */
  #110 = CARTESIAN_POINT('', (1.0, 1.0, 0.0));
  #111 = CARTESIAN_POINT('', (3.0, 1.0, 0.0));
  #112 = CARTESIAN_POINT('', (2.0, 3.0, 0.0));

  #120 = VERTEX_POINT('', #110);
  #121 = VERTEX_POINT('', #111);
  #122 = VERTEX_POINT('', #112);

  #140 = LINE('', #110, #100);
  #141 = LINE('', #111, #100);
  #142 = LINE('', #112, #100);

  #130 = EDGE_CURVE('', #120, #121, #140, .T.);
  #131 = EDGE_CURVE('', #121, #122, #141, .T.);
  #132 = EDGE_CURVE('', #122, #120, #142, .T.);

  #150 = ORIENTED_EDGE('', *, *, #130, .T.);
  #151 = ORIENTED_EDGE('', *, *, #131, .T.);
  #152 = ORIENTED_EDGE('', *, *, #132, .T.);

  #160 = EDGE_LOOP('', (#150, #151, #152));
  #170 = FACE_BOUND('', #160, .T.);

  #80 = ADVANCED_FACE('', (#70, #170), #5, .T.);

ENDSEC;
END-ISO-10303-21;
