ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Simple cylinder for C4 testing'), '2;1');
FILE_NAME('cylinder.step', '2024-01-01T00:00:00', (''), (''), '', '', '');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;

DATA;
/* Simple cylinder: radius=1, height=2, centered at origin, axis along Z */

/* Geometry context */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=DIRECTION('axis',(0.,0.,1.));
#3=DIRECTION('refdir',(1.,0.,0.));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);

/* Cylinder surface */
#10=CYLINDRICAL_SURFACE('',#4,1.0);

/* Bottom circle (z=0) */
#20=CARTESIAN_POINT('',(0.,0.,0.));
#21=DIRECTION('',(0.,0.,1.));
#22=DIRECTION('',(1.,0.,0.));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=CIRCLE('',#23,1.0);

/* Top circle (z=2) */
#30=CARTESIAN_POINT('',(0.,0.,2.));
#31=DIRECTION('',(0.,0.,1.));
#32=DIRECTION('',(1.,0.,0.));
#33=AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34=CIRCLE('',#33,1.0);

/* Vertices on bottom circle */
#40=CARTESIAN_POINT('',(1.,0.,0.));
#41=VERTEX_POINT('',#40);

/* Vertices on top circle */
#50=CARTESIAN_POINT('',(1.,0.,2.));
#51=VERTEX_POINT('',#50);

/* Seam line (vertical edge connecting top and bottom at x=1) */
#60=CARTESIAN_POINT('',(1.,0.,0.));
#61=DIRECTION('',(0.,0.,1.));
#62=VECTOR('',#61,2.0);
#63=LINE('',#60,#62);

/* Edge curves */
#70=EDGE_CURVE('',#41,#41,#24,.T.);
#71=EDGE_CURVE('',#51,#51,#34,.T.);
#72=EDGE_CURVE('',#41,#51,#63,.T.);

/* Oriented edges for the cylindrical face */
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#72,.T.);
#82=ORIENTED_EDGE('',*,*,#71,.F.);
#83=ORIENTED_EDGE('',*,*,#72,.F.);

/* Edge loop for cylinder lateral surface */
#90=EDGE_LOOP('',(#80,#81,#82,#83));
#91=FACE_OUTER_BOUND('',#90,.T.);

/* The cylindrical face */
#100=ADVANCED_FACE('',(#91),#10,.T.);

/* Bottom cap (planar) */
#110=PLANE('',#23);
#111=ORIENTED_EDGE('',*,*,#70,.F.);
#112=EDGE_LOOP('',(#111));
#113=FACE_OUTER_BOUND('',#112,.T.);
#114=ADVANCED_FACE('',(#113),#110,.F.);

/* Top cap (planar) */
#120=PLANE('',#33);
#121=ORIENTED_EDGE('',*,*,#71,.T.);
#122=EDGE_LOOP('',(#121));
#123=FACE_OUTER_BOUND('',#122,.T.);
#124=ADVANCED_FACE('',(#123),#120,.T.);

/* Shell and solid */
#130=CLOSED_SHELL('',(#100,#114,#124));
#131=MANIFOLD_SOLID_BREP('cylinder',#130);

/* Representation context */
#200=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#201,#202)) REPRESENTATION_CONTEXT('','3D'));
#201=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#202=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));

/* Shape representation */
#210=SHAPE_REPRESENTATION('',(#4,#131),#200);
#211=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#131),#200);

/* Product structure */
#220=PRODUCT('cylinder','Simple Cylinder','',(#221));
#221=PRODUCT_CONTEXT('',#222,'mechanical');
#222=APPLICATION_CONTEXT('automotive design');
#223=PRODUCT_DEFINITION_FORMATION('','',#220);
#224=PRODUCT_DEFINITION('','',#223,#225);
#225=PRODUCT_DEFINITION_CONTEXT('part definition',#222,'design');
#226=PRODUCT_DEFINITION_SHAPE('','',#224);
#227=SHAPE_DEFINITION_REPRESENTATION(#226,#211);

ENDSEC;
END-ISO-10303-21;
