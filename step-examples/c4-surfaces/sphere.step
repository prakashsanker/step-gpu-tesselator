ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Simple sphere for C4 testing'), '2;1');
FILE_NAME('sphere.step', '2024-01-01T00:00:00', (''), (''), '', '', '');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;

DATA;
/* Simple sphere: radius=1, centered at origin */

/* Geometry context */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=DIRECTION('axis',(0.,0.,1.));
#3=DIRECTION('refdir',(1.,0.,0.));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);

/* Spherical surface */
#10=SPHERICAL_SURFACE('',#4,1.0);

/* North pole vertex */
#20=CARTESIAN_POINT('',(0.,0.,1.));
#21=VERTEX_POINT('',#20);

/* South pole vertex */
#30=CARTESIAN_POINT('',(0.,0.,-1.));
#31=VERTEX_POINT('',#30);

/* Seam point on equator */
#40=CARTESIAN_POINT('',(1.,0.,0.));
#41=VERTEX_POINT('',#40);

/* Meridian arc from south pole to north pole (semicircle in XZ plane) */
#50=CARTESIAN_POINT('',(0.,0.,0.));
#51=DIRECTION('',(0.,1.,0.));
#52=DIRECTION('',(1.,0.,0.));
#53=AXIS2_PLACEMENT_3D('',#50,#51,#52);
#54=CIRCLE('',#53,1.0);

/* Edge curves - two semicircular arcs forming the seam */
#60=EDGE_CURVE('',#31,#21,#54,.T.);
#61=EDGE_CURVE('',#21,#31,#54,.T.);

/* Oriented edges */
#70=ORIENTED_EDGE('',*,*,#60,.T.);
#71=ORIENTED_EDGE('',*,*,#61,.T.);

/* Edge loop (degenerate - two semicircles) */
#80=EDGE_LOOP('',(#70,#71));
#81=FACE_OUTER_BOUND('',#80,.T.);

/* The spherical face */
#100=ADVANCED_FACE('',(#81),#10,.T.);

/* Shell and solid */
#130=CLOSED_SHELL('',(#100));
#131=MANIFOLD_SOLID_BREP('sphere',#130);

/* Representation context */
#200=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#201,#202)) REPRESENTATION_CONTEXT('','3D'));
#201=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#202=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));

/* Shape representation */
#210=SHAPE_REPRESENTATION('',(#4,#131),#200);
#211=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#131),#200);

/* Product structure */
#220=PRODUCT('sphere','Simple Sphere','',(#221));
#221=PRODUCT_CONTEXT('',#222,'mechanical');
#222=APPLICATION_CONTEXT('automotive design');
#223=PRODUCT_DEFINITION_FORMATION('','',#220);
#224=PRODUCT_DEFINITION('','',#223,#225);
#225=PRODUCT_DEFINITION_CONTEXT('part definition',#222,'design');
#226=PRODUCT_DEFINITION_SHAPE('','',#224);
#227=SHAPE_DEFINITION_REPRESENTATION(#226,#211);

ENDSEC;
END-ISO-10303-21;
