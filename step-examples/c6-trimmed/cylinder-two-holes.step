ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Simple cylinder for C4 testing'), '2;1');
FILE_NAME('cylinder.step', '2024-01-01T00:00:00', (''), (''), '', '', '');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;

DATA;
/* Simple cylinder: radius=1, height=2, centered at origin, axis along Z */

/* Geometry context */
#1=CARTESIAN_POINT('origin',(0.,0.,0.));
#2=DIRECTION('axis',(0.,0.,1.));
#3=DIRECTION('refdir',(1.,0.,0.));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);

/* Cylinder surface */
#10=CYLINDRICAL_SURFACE('',#4,1.0);

/* Bottom circle (z=0) */
#20=CARTESIAN_POINT('',(0.,0.,0.));
#21=DIRECTION('',(0.,0.,1.));
#22=DIRECTION('',(1.,0.,0.));
#23=AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24=CIRCLE('',#23,1.0);

/* Top circle (z=2) */
#30=CARTESIAN_POINT('',(0.,0.,2.));
#31=DIRECTION('',(0.,0.,1.));
#32=DIRECTION('',(1.,0.,0.));
#33=AXIS2_PLACEMENT_3D('',#30,#31,#32);
#34=CIRCLE('',#33,1.0);

/* Vertices on bottom circle */
#40=CARTESIAN_POINT('',(1.,0.,0.));
#41=VERTEX_POINT('',#40);

/* Vertices on top circle */
#50=CARTESIAN_POINT('',(1.,0.,2.));
#51=VERTEX_POINT('',#50);

/* Seam line (vertical edge connecting top and bottom at x=1) */
#60=CARTESIAN_POINT('',(1.,0.,0.));
#61=DIRECTION('',(0.,0.,1.));
#62=VECTOR('',#61,2.0);
#63=LINE('',#60,#62);

/* Edge curves */
#70=EDGE_CURVE('',#41,#41,#24,.T.);
#71=EDGE_CURVE('',#51,#51,#34,.T.);
#72=EDGE_CURVE('',#41,#51,#63,.T.);

/* Oriented edges for the cylindrical face */
#80=ORIENTED_EDGE('',*,*,#70,.T.);
#81=ORIENTED_EDGE('',*,*,#72,.T.);
#82=ORIENTED_EDGE('',*,*,#71,.F.);
#83=ORIENTED_EDGE('',*,*,#72,.F.);

/* Edge loop for cylinder lateral surface */
#90=EDGE_LOOP('',(#80,#81,#82,#83));
#91=FACE_OUTER_BOUND('',#90,.T.);

/* ============================================ */
/* HOLE 1: Front side                           */
/* From angle 30deg to 90deg, z=0.3 to z=0.9    */
/* ============================================ */

/* Hole 1 corner points */
/* h1: 30deg -> (0.866025, 0.5, 0.3) */
/* h2: 90deg -> (0, 1, 0.3) */
/* h3: 90deg -> (0, 1, 0.9) */
/* h4: 30deg -> (0.866025, 0.5, 0.9) */
#300=CARTESIAN_POINT('',(0.866025,0.5,0.3));
#301=CARTESIAN_POINT('',(0.,1.,0.3));
#302=CARTESIAN_POINT('',(0.,1.,0.9));
#303=CARTESIAN_POINT('',(0.866025,0.5,0.9));
#304=VERTEX_POINT('',#300);
#305=VERTEX_POINT('',#301);
#306=VERTEX_POINT('',#302);
#307=VERTEX_POINT('',#303);

/* Hole 1 bottom arc (z=0.3): 30deg to 90deg CCW = short path */
#310=CARTESIAN_POINT('',(0.,0.,0.3));
#311=DIRECTION('',(0.,0.,1.));
#312=DIRECTION('',(1.,0.,0.));
#313=AXIS2_PLACEMENT_3D('',#310,#311,#312);
#314=CIRCLE('',#313,1.0);
#315=EDGE_CURVE('',#304,#305,#314,.T.);

/* Hole 1 right edge (h2 to h3) */
#320=CARTESIAN_POINT('',(0.,1.,0.3));
#321=DIRECTION('',(0.,0.,1.));
#322=VECTOR('',#321,0.6);
#323=LINE('',#320,#322);
#324=EDGE_CURVE('',#305,#306,#323,.T.);

/* Hole 1 top arc (z=0.9): 90deg to 30deg CW = short path, sameSense=.F. */
#330=CARTESIAN_POINT('',(0.,0.,0.9));
#331=DIRECTION('',(0.,0.,1.));
#332=DIRECTION('',(1.,0.,0.));
#333=AXIS2_PLACEMENT_3D('',#330,#331,#332);
#334=CIRCLE('',#333,1.0);
#335=EDGE_CURVE('',#306,#307,#334,.F.);

/* Hole 1 left edge (h4 to h1) */
#340=CARTESIAN_POINT('',(0.866025,0.5,0.9));
#341=DIRECTION('',(0.,0.,-1.));
#342=VECTOR('',#341,0.6);
#343=LINE('',#340,#342);
#344=EDGE_CURVE('',#307,#304,#343,.T.);

/* Hole 1 oriented edges */
#350=ORIENTED_EDGE('',*,*,#315,.T.);
#351=ORIENTED_EDGE('',*,*,#324,.T.);
#352=ORIENTED_EDGE('',*,*,#335,.T.);
#353=ORIENTED_EDGE('',*,*,#344,.T.);

/* Hole 1 edge loop */
#360=EDGE_LOOP('',(#350,#351,#352,#353));
#361=FACE_BOUND('',#360,.F.);

/* ============================================ */
/* HOLE 2: Back side                            */
/* From angle 225deg to 315deg, z=1.1 to z=1.7  */
/* ============================================ */

/* Hole 2 corner points */
/* h5: 225deg -> (-0.707107, -0.707107, 1.1) */
/* h6: 315deg -> (0.707107, -0.707107, 1.1) */
/* h7: 315deg -> (0.707107, -0.707107, 1.7) */
/* h8: 225deg -> (-0.707107, -0.707107, 1.7) */
#400=CARTESIAN_POINT('',(-0.707107,-0.707107,1.1));
#401=CARTESIAN_POINT('',(0.707107,-0.707107,1.1));
#402=CARTESIAN_POINT('',(0.707107,-0.707107,1.7));
#403=CARTESIAN_POINT('',(-0.707107,-0.707107,1.7));
#404=VERTEX_POINT('',#400);
#405=VERTEX_POINT('',#401);
#406=VERTEX_POINT('',#402);
#407=VERTEX_POINT('',#403);

/* Hole 2 bottom arc (z=1.1): 225deg to 315deg CCW = short path */
#410=CARTESIAN_POINT('',(0.,0.,1.1));
#411=DIRECTION('',(0.,0.,1.));
#412=DIRECTION('',(1.,0.,0.));
#413=AXIS2_PLACEMENT_3D('',#410,#411,#412);
#414=CIRCLE('',#413,1.0);
#415=EDGE_CURVE('',#404,#405,#414,.T.);

/* Hole 2 right edge (h6 to h7) */
#420=CARTESIAN_POINT('',(0.707107,-0.707107,1.1));
#421=DIRECTION('',(0.,0.,1.));
#422=VECTOR('',#421,0.6);
#423=LINE('',#420,#422);
#424=EDGE_CURVE('',#405,#406,#423,.T.);

/* Hole 2 top arc (z=1.7): 315deg to 225deg CW = short path, sameSense=.F. */
#430=CARTESIAN_POINT('',(0.,0.,1.7));
#431=DIRECTION('',(0.,0.,1.));
#432=DIRECTION('',(1.,0.,0.));
#433=AXIS2_PLACEMENT_3D('',#430,#431,#432);
#434=CIRCLE('',#433,1.0);
#435=EDGE_CURVE('',#406,#407,#434,.F.);

/* Hole 2 left edge (h8 to h5) */
#440=CARTESIAN_POINT('',(-0.707107,-0.707107,1.7));
#441=DIRECTION('',(0.,0.,-1.));
#442=VECTOR('',#441,0.6);
#443=LINE('',#440,#442);
#444=EDGE_CURVE('',#407,#404,#443,.T.);

/* Hole 2 oriented edges */
#450=ORIENTED_EDGE('',*,*,#415,.T.);
#451=ORIENTED_EDGE('',*,*,#424,.T.);
#452=ORIENTED_EDGE('',*,*,#435,.T.);
#453=ORIENTED_EDGE('',*,*,#444,.T.);

/* Hole 2 edge loop */
#460=EDGE_LOOP('',(#450,#451,#452,#453));
#461=FACE_BOUND('',#460,.F.);

/* The cylindrical face with two holes */
#100=ADVANCED_FACE('',(#91,#361,#461),#10,.T.);

/* Bottom cap (planar) */
#110=PLANE('',#23);
#111=ORIENTED_EDGE('',*,*,#70,.F.);
#112=EDGE_LOOP('',(#111));
#113=FACE_OUTER_BOUND('',#112,.T.);
#114=ADVANCED_FACE('',(#113),#110,.F.);

/* Top cap (planar) */
#120=PLANE('',#33);
#121=ORIENTED_EDGE('',*,*,#71,.T.);
#122=EDGE_LOOP('',(#121));
#123=FACE_OUTER_BOUND('',#122,.T.);
#124=ADVANCED_FACE('',(#123),#120,.T.);

/* Shell and solid */
#130=CLOSED_SHELL('',(#100,#114,#124));
#131=MANIFOLD_SOLID_BREP('cylinder',#130);

/* Representation context */
#200=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#201,#202)) REPRESENTATION_CONTEXT('','3D'));
#201=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#202=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));

/* Shape representation */
#210=SHAPE_REPRESENTATION('',(#4,#131),#200);
#211=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#131),#200);

/* Product structure */
#220=PRODUCT('cylinder','Simple Cylinder','',(#221));
#221=PRODUCT_CONTEXT('',#222,'mechanical');
#222=APPLICATION_CONTEXT('automotive design');
#223=PRODUCT_DEFINITION_FORMATION('','',#220);
#224=PRODUCT_DEFINITION('','',#223,#225);
#225=PRODUCT_DEFINITION_CONTEXT('part definition',#222,'design');
#226=PRODUCT_DEFINITION_SHAPE('','',#224);
#227=SHAPE_DEFINITION_REPRESENTATION(#226,#211);

ENDSEC;
END-ISO-10303-21;
