ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Half cylinder - trimmed cylindrical surface'), '2;1');
FILE_NAME('half-cylinder.step', '2024-01-01T00:00:00', (''), (''), '', '', '');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;

DATA;
/* Half cylinder: 180 degrees of a cylinder */
/* Axis placement at origin, Z-up */
#1=CARTESIAN_POINT('',(0.,0.,0.));
#2=DIRECTION('',(0.,0.,1.));
#3=DIRECTION('',(1.,0.,0.));
#4=AXIS2_PLACEMENT_3D('',#1,#2,#3);
#5=CYLINDRICAL_SURFACE('',#4,1.);

/* Four corner points of the half-cylinder patch */
#10=CARTESIAN_POINT('',(1.,0.,0.));
#11=CARTESIAN_POINT('',(-1.,0.,0.));
#12=CARTESIAN_POINT('',(-1.,0.,2.));
#13=CARTESIAN_POINT('',(1.,0.,2.));

/* Two arc edges (top and bottom of the half-cylinder) */
/* Bottom arc: from (1,0,0) to (-1,0,0) going through (0,1,0) */
#20=CIRCLE('',#4,1.);

/* Top arc at z=2 */
#21=CARTESIAN_POINT('',(0.,0.,2.));
#22=AXIS2_PLACEMENT_3D('',#21,#2,#3);
#23=CIRCLE('',#22,1.);

/* Two straight line edges (sides of the half-cylinder) */
#30=CARTESIAN_POINT('',(1.,0.,0.));
#31=DIRECTION('',(0.,0.,1.));
#32=VECTOR('',#31,1.);
#33=LINE('',#30,#32);

#34=CARTESIAN_POINT('',(-1.,0.,0.));
#35=LINE('',#34,#32);

/* Vertices */
#40=VERTEX_POINT('',#10);
#41=VERTEX_POINT('',#11);
#42=VERTEX_POINT('',#12);
#43=VERTEX_POINT('',#13);

/* Edge curves */
#50=EDGE_CURVE('',#40,#41,#20,.T.);
#51=EDGE_CURVE('',#41,#42,#35,.T.);
#52=EDGE_CURVE('',#42,#43,#23,.F.);
#53=EDGE_CURVE('',#43,#40,#33,.F.);

/* Oriented edges for the loop */
#60=ORIENTED_EDGE('',*,*,#50,.T.);
#61=ORIENTED_EDGE('',*,*,#51,.T.);
#62=ORIENTED_EDGE('',*,*,#52,.T.);
#63=ORIENTED_EDGE('',*,*,#53,.T.);

#70=EDGE_LOOP('',(#60,#61,#62,#63));
#71=FACE_OUTER_BOUND('',#70,.T.);
#80=ADVANCED_FACE('',(#71),#5,.T.);

#90=CLOSED_SHELL('',(#80));
#91=MANIFOLD_SOLID_BREP('half_cylinder',#90);

#100=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNIT_ASSIGNED_CONTEXT((#101,#102)) REPRESENTATION_CONTEXT('','3D'));
#101=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#102=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#110=SHAPE_REPRESENTATION('',(#91),#100);
#111=ADVANCED_BREP_SHAPE_REPRESENTATION('',(#91),#100);
#120=PRODUCT('half_cylinder','Half Cylinder','',(#121));
#121=PRODUCT_CONTEXT('',#122,'mechanical');
#122=APPLICATION_CONTEXT('automotive design');
#123=PRODUCT_DEFINITION_FORMATION('','',#120);
#124=PRODUCT_DEFINITION('','',#123,#125);
#125=PRODUCT_DEFINITION_CONTEXT('part definition',#122,'design');
#126=PRODUCT_DEFINITION_SHAPE('','',#124);
#127=SHAPE_DEFINITION_REPRESENTATION(#126,#111);
ENDSEC;
END-ISO-10303-21;
